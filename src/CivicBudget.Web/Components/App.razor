@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CivicBudget.Web.Security
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CivicBudget.Web.styles.css"]" />
    @* Only interactive pages load modules. The import map is an inline script, so it carries this
       request's nonce to pass the Content-Security-Policy (SecurityHeadersMiddleware). *@
    @if (PageRenderMode is not null)
    {
        <ImportMap nonce="@SecurityHeadersMiddleware.Nonce(HttpContext)" />
    }
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body data-idle-minutes="@IdleMinutes">
    @* Interactive Server for the whole admin app, layout included: with per-page render modes the
       layout stays static, so nothing in the sidebar or the toast host could react to anything.
       The portal and the account pages opt out with [ExcludeFromInteractiveRouting]; for those
       requests PageRenderMode is null and the page is plain static SSR with no circuit (ADR-0002). *@
    <Routes @rendermode="PageRenderMode" />
    @* Scripts only where something is interactive. The portal, the sign-in pages, and the error pages
       are plain HTML and forms; without this every one of them downloaded Blazor, Bootstrap, and the
       reconnect dialog for nothing, and the portal promised to work with no JavaScript at all. *@
    @* The one script a static page may carry: show/hide on password fields, on the sign-in and
       account pages only. The portal stays script-free. *@
    @if (PageRenderMode is not null || HttpContext.Request.Path.StartsWithSegments("/Account", StringComparison.OrdinalIgnoreCase))
    {
        <script src="@Assets["js/password-toggle.js"]"></script>
    }
    @* The idle clock on the account pages too, which are static; the admin app loads it below. *@
    @if (PageRenderMode is null && IdleMinutes is not null && HttpContext.Request.Path.StartsWithSegments("/Account/Manage", StringComparison.OrdinalIgnoreCase))
    {
        <script src="@Assets["js/session.js"]"></script>
    }
    @if (PageRenderMode is not null)
    {
        <ReconnectModal />
        <script src="@Assets["_framework/blazor.web.js"]"></script>
        <script src="@Assets["lib/bootstrap/js/bootstrap.bundle.min.js"]"></script>
        <script src="@Assets["js/civicbudget.js"]"></script>
        <script src="@Assets["js/session.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Minutes of inactivity before the browser signs this session out: set for a signed-in session
    /// that is not remembered on this device, null otherwise (no idle clock runs).
    /// </summary>
    private int? IdleMinutes;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            AuthenticateResult session = await HttpContext.AuthenticateAsync(IdentityConstants.ApplicationScheme);
            IdleMinutes = session.Properties?.IsPersistent == true ? null : (int)SessionPolicy.IdleTimeout.TotalMinutes;
        }
    }

    /// <summary>Interactive Server unless the routed page carries [ExcludeFromInteractiveRouting].</summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
