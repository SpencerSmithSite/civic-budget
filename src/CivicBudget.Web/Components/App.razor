<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CivicBudget.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @* Interactive Server for the whole admin app, layout included: with per-page render modes the
       layout stays static, so nothing in the sidebar or the toast host could react to anything.
       The portal and the account pages opt out with [ExcludeFromInteractiveRouting]; for those
       requests PageRenderMode is null and the page is plain static SSR with no circuit (ADR-0002). *@
    <Routes @rendermode="PageRenderMode" />
    @* Scripts only where something is interactive. The portal, the sign-in pages, and the error pages
       are plain HTML and forms; without this every one of them downloaded Blazor, Bootstrap, and the
       reconnect dialog for nothing, and the portal promised to work with no JavaScript at all. *@
    @if (PageRenderMode is not null)
    {
        <ReconnectModal />
        <script src="@Assets["_framework/blazor.web.js"]"></script>
        <script src="@Assets["lib/bootstrap/js/bootstrap.bundle.min.js"]"></script>
        <script>
            // The admin app's only bespoke JavaScript: remember a UI preference (the collapsed menu) in a
            // cookie, so the server can prerender the page the way the user left it.
            window.civicBudget = {
                setCookie: (name, value) => { document.cookie = `${name}=${value};path=/;max-age=31536000;SameSite=Lax`; },
                // Dialogs and drawers remember what had focus when they opened and hand it back when they
                // close, so a keyboard user carries on from the button they pressed, not the top of the page.
                rememberFocus: () => { window.civicBudget.lastFocus = document.activeElement; },
                restoreFocus: () => {
                    const el = window.civicBudget.lastFocus;
                    if (el && el.isConnected && typeof el.focus === "function") { el.focus(); }
                }
            };
        </script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Interactive Server unless the routed page carries [ExcludeFromInteractiveRouting].</summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
