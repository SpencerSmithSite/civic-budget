@page "/not-found"
@layout MainLayout
@attribute [ExcludeFromInteractiveRouting]

@* The status-code pages middleware re-executes here for any 404 outside the portal (the portal
   shows its own). Static like the other public pages: nothing on it needs a live connection. *@
<PageTitle>Page not found</PageTitle>

<div class="container py-5">
    <EmptyState IsPageHeading="true" Icon="bi-signpost-split" Title="Page not found" Text="That address does not match a page. It may have moved, or the link may be mistyped.">
        <a class="btn btn-primary btn-sm" href="">Go to the home page</a>
        <a class="btn btn-outline-primary btn-sm" href="transparency">Published budgets</a>
    </EmptyState>
</div>
