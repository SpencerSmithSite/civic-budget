@page "/"

@* The front door. Nothing here describes the product or the project: a signed-out user signs in,
   a signed-in user continues, and anyone can reach the public portal. *@
<PageTitle>CivicBudget</PageTitle>

<div class="cb-login">
    <div class="cb-login-left">
        <h1>Budgeting and public transparency for local governments.</h1>
    </div>
    <div class="cb-login-right">
        <div class="card cb-login-card">
            <div class="card-body p-4">
                <AuthorizeView>
                    <Authorized>
                        <h2 class="h5 mb-1">Welcome back</h2>
                        <p class="text-secondary small mb-3">Signed in as <b>@(context.User.FindFirst(ClaimNames.DisplayName)?.Value)</b>.</p>
                        <a class="btn btn-primary w-100" href="admin">Continue</a>
                    </Authorized>
                    <NotAuthorized>
                        <h2 class="h5 mb-3">Sign in to view and enter data</h2>
                        <a class="btn btn-primary w-100" href="Account/Login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
                <hr>
                <p class="small text-secondary mb-2">Looking for a published budget?</p>
                <a class="btn btn-outline-primary w-100" href="transparency">Public transparency portal</a>
            </div>
        </div>
    </div>
</div>
