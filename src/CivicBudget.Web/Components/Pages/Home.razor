@page "/"

<PageTitle>CivicBudget</PageTitle>

<div class="px-3">
    <h1>CivicBudget</h1>
    <p class="lead">Budgeting and public transparency for local governments.</p>
    <AuthorizeView>
        <Authorized>
            <p>Signed in as <strong>@(context.User.FindFirst(ClaimNames.DisplayName)?.Value)</strong>. <a href="admin">Go to the admin area</a>.</p>
        </Authorized>
        <NotAuthorized>
            <p><a class="btn btn-primary" href="Account/Login">Log in</a></p>
        </NotAuthorized>
    </AuthorizeView>
    <p class="text-secondary small">Phase 2: identity and maintenance. Budget entry arrives in Phase 3; the public portal in Phase 5.</p>
</div>
