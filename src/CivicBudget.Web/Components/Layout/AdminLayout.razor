@inherits LayoutComponentBase
@implements IDisposable
@inject AdminPageState PageState
@inject IGovernmentSettingsService SettingsService
@inject IJSRuntime JS
@inject PersistentComponentState ApplicationState
@using CivicBudget.Application.Setup

@* The admin shell: a dark sidebar of module groups, a white top bar with the page's breadcrumb
   trail and the signed-in user, and the page. Links are shown per policy so a Viewer never sees
   a "Users" link they cannot use (the pages are still protected server-side). Under 992px the
   sidebar slides in over the page from a hamburger button; above it the sidebar can collapse to
   an icon rail (the choice is kept in a cookie so the prerender already knows it). *@
<div class="cb-shell @(collapsed ? "collapsed" : "")">
    <aside class="cb-sidebar @(menuOpen ? "open" : "")" id="admin-sidebar">
        <div class="cb-sidebar-head">
            <a class="cb-brand" href="admin" aria-label="@($"{governmentName ?? "CivicBudget"} home")" title="@governmentName">
                <Logo Size="36" />
                <span class="cb-brand-gov">@(governmentName ?? "")</span>
            </a>
            <button type="button" class="cb-collapse" @onclick="ToggleCollapsedAsync" aria-expanded="@(!collapsed)" aria-controls="admin-sidebar"
                    title="@(collapsed ? "Expand menu" : "Collapse menu")" aria-label="@(collapsed ? "Expand menu" : "Collapse menu")">
                <i class="bi @(collapsed ? "bi-chevron-double-right" : "bi-chevron-double-left")" aria-hidden="true"></i>
            </button>
            @* Under 992px the sidebar is a drawer; this closes it (the chevron above is hidden there). *@
            <button type="button" class="cb-collapse cb-drawer-close" @onclick="CloseMenu" aria-controls="admin-sidebar" title="Close menu" aria-label="Close menu">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <AuthorizeView Policy="@Policies.CanViewBudget">
            <div class="cb-navgroup">Budget</div>
            <nav class="nav cb-nav flex-column" aria-label="Budget">
                <AuthorizeView Roles="@Roles.DepartmentHead" Context="member">
                    <Authorized><NavLink class="nav-link" href="admin/my-department" @onclick="CloseMenu"><i class="bi bi-building" aria-hidden="true"></i>My department</NavLink></Authorized>
                    <NotAuthorized><NavLink class="nav-link" href="admin" Match="NavLinkMatch.All" @onclick="CloseMenu"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Overview</NavLink></NotAuthorized>
                </AuthorizeView>
                <NavLink class="nav-link" href="admin/budgets" @onclick="CloseMenu"><i class="bi bi-journal-text" aria-hidden="true"></i>Budget versions</NavLink>
                <NavLink class="nav-link" href="admin/reports" @onclick="CloseMenu"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>Reports</NavLink>
            </nav>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.CanMaintainSetup">
            <div class="cb-navgroup">Setup</div>
            <nav class="nav cb-nav flex-column" aria-label="Setup">
                <NavLink class="nav-link" href="admin/funds" @onclick="CloseMenu"><i class="bi bi-bank" aria-hidden="true"></i>Funds</NavLink>
                <NavLink class="nav-link" href="admin/departments" @onclick="CloseMenu"><i class="bi bi-diagram-3" aria-hidden="true"></i>Departments</NavLink>
                <NavLink class="nav-link" href="admin/accounts" @onclick="CloseMenu"><i class="bi bi-list-columns" aria-hidden="true"></i>Chart of accounts</NavLink>
                <NavLink class="nav-link" href="admin/fiscal-years" @onclick="CloseMenu"><i class="bi bi-calendar3" aria-hidden="true"></i>Fiscal years</NavLink>
                <NavLink class="nav-link" href="admin/chart-sync" @onclick="CloseMenu"><i class="bi bi-cloud-download" aria-hidden="true"></i>Chart sync</NavLink>
            </nav>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.CanManageUsers">
            <div class="cb-navgroup">Administration</div>
            <nav class="nav cb-nav flex-column" aria-label="Administration">
                <NavLink class="nav-link" href="admin/users" @onclick="CloseMenu"><i class="bi bi-people" aria-hidden="true"></i>Users</NavLink>
                <NavLink class="nav-link" href="admin/settings" @onclick="CloseMenu"><i class="bi bi-sliders" aria-hidden="true"></i>Government settings</NavLink>
            </nav>
        </AuthorizeView>
        <div class="cb-navgroup">Public portal</div>
        <nav class="nav cb-nav flex-column" aria-label="Public portal">
            <NavLink class="nav-link" href="admin/budgets#publishing" @onclick="CloseMenu"><i class="bi bi-megaphone" aria-hidden="true"></i>Publishing history</NavLink>
            <a class="nav-link" href="transparency/@publicSlug" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>Open portal</a>
        </nav>
        <div class="cb-sidebar-foot">Ohio fund accounting · @fiscalYearNote</div>
    </aside>

    @if (menuOpen)
    {
        <div class="cb-drawer-backdrop d-lg-none" @onclick="CloseMenu"></div>
    }

    <div>
        <header class="cb-topbar">
            <button type="button" class="btn btn-outline-primary btn-sm cb-menu-toggle" aria-controls="admin-sidebar" aria-expanded="@menuOpen" @onclick="() => menuOpen = !menuOpen">
                <i class="bi bi-list" aria-hidden="true"></i><span class="visually-hidden">Menu</span>
            </button>
            <ol class="cb-crumbs" aria-label="Breadcrumb">
                @foreach (Crumb crumb in PageState.Crumbs)
                {
                    <li>@if (crumb.Href is not null) { <a href="@crumb.Href">@crumb.Text</a> } else { @crumb.Text }</li>
                }
            </ol>
            <div class="flex-grow-1"></div>
            <AuthorizeView>
                <div class="dropdown">
                    <button type="button" class="btn btn-link text-decoration-none p-0 cb-user" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="menu"
                            aria-label="@($"Account menu, {context.User.FindFirst(ClaimNames.DisplayName)?.Value}")">
                        <Avatar UserId="@context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" Name="@context.User.FindFirst(ClaimNames.DisplayName)?.Value" />
                        <span class="d-none d-sm-block text-start text-body">@context.User.FindFirst(ClaimNames.DisplayName)?.Value<small>@string.Join(", ", context.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => Roles.DisplayName(c.Value)))</small></span>
                        <i class="bi bi-chevron-down small text-body" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="Account/Manage"><i class="bi bi-person me-2" aria-hidden="true"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="admin/profile-picture"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>Profile picture</a></li>
                        <li><a class="dropdown-item" href="Account/Manage/ChangePassword"><i class="bi bi-key me-2" aria-hidden="true"></i>Change password</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Log out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </AuthorizeView>
        </header>
        <main class="cb-main">
            @* A failure in one page shows here instead of taking the whole connection down; the
               sidebar keeps working, and navigating elsewhere clears it (OnParametersSet). *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="card">
                        <EmptyState Icon="bi-exclamation-triangle" Title="This page ran into a problem" Text="Your saved work is safe. Anything not yet saved on this page may need to be entered again.">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="() => errorBoundary?.Recover()">Try again</button>
                            <a class="btn btn-outline-primary btn-sm" href="admin">Go to the overview</a>
                        </EmptyState>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>
<ToastHost />

@* Shown by blazor.web.js when the connection itself fails, which an error boundary cannot catch. *@
<div id="blazor-error-ui" data-nosnippet role="alert">
    Something went wrong and this page stopped responding. <a href="" class="reload">Reload</a> to continue.
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>

@code {
    private const string CollapsedCookie = "cb.sidebar";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool menuOpen;
    private ErrorBoundary? errorBoundary;
    private bool collapsed;
    private PersistingComponentStateSubscription persisting;
    private string? governmentName;
    private string publicSlug = "";
    private string fiscalYearNote = "";

    protected override async Task OnInitializedAsync()
    {
        PageState.Changed += OnPageStateChanged;
        // During prerender the request is available and the cookie says whether the user collapsed the
        // menu last time. The interactive circuit has no request, so the value is handed over through
        // persistent component state; without that hand-off the rail would flash open on every page.
        persisting = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson(CollapsedCookie, collapsed);
            return Task.CompletedTask;
        });
        collapsed = ApplicationState.TryTakeFromJson(CollapsedCookie, out bool persisted)
            ? persisted
            : HttpContext?.Request.Cookies[CollapsedCookie] == "1";
        GovernmentSettingsDto government = await SettingsService.GetAsync();
        governmentName = government.Name;
        publicSlug = government.PublicSlug;
        fiscalYearNote = "FY starts " + System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(government.FiscalYearStartMonth);
    }

    // The layout gets new parameters (a new Body) on every navigation; a page that failed should not
    // keep showing its error once the user has gone somewhere else.
    protected override void OnParametersSet() => errorBoundary?.Recover();

    private void OnPageStateChanged() => InvokeAsync(StateHasChanged);

    private void CloseMenu() => menuOpen = false;

    private async Task ToggleCollapsedAsync()
    {
        collapsed = !collapsed;
        await JS.InvokeVoidAsync("civicBudget.setCookie", CollapsedCookie, collapsed ? "1" : "0");
    }

    public void Dispose()
    {
        PageState.Changed -= OnPageStateChanged;
        persisting.Dispose();
    }
}
