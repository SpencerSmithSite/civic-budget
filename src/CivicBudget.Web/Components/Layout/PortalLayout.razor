@inherits LayoutComponentBase
@using CivicBudget.Application.Portal
@using CivicBudget.Web.Components.Portal.Common
@inject NavigationManager Navigation
@inject ISnapshotQueryService Snapshots
@inject CivicBudget.Application.Assistant.IPortalQuestionService Questions

@* The citizen-facing shell: a navy header band with the government's name and question-led
   navigation, the page, and a one-line footer (which budget, downloads, glossary, accessibility).
   Static SSR: rendered once per request, then cached. *@
<div class="cb-portal @(ShowBuddy ? "pt-has-buddy" : "")">
    <a class="cb-skip" href="#main">Skip to content</a>
    <header class="pt-bar">
        <div class="pt-in pt-bar-in">
            <a class="pt-brand" href="@(route?.Root ?? "/transparency")" aria-label="@($"{budget?.GovernmentName ?? "CivicBudget"} budget transparency portal home")">
                @if (budget?.LogoVersion is { } logo && route is not null)
                {
                    <img class="pt-logo" src="/transparency/@route.Slug/logo?v=@logo" alt="" />
                }
                else
                {
                    <Logo Size="40" Label="" />
                }
                <span><b>@(budget?.GovernmentName ?? "CivicBudget")</b><small>Budget transparency portal</small></span>
            </a>
            @if (budget is not null && route is not null)
            {
                <nav class="pt-nav" aria-label="Portal">
                    <a href="@Root" class="@Active("")" aria-current="@Current("")">Overview</a>
                    <a href="@Root/spending" class="@Active("spending")" aria-current="@Current("spending")">Where it goes</a>
                    <a href="@Root/revenue" class="@Active("revenue")" aria-current="@Current("revenue")">Where it comes from</a>
                    <a href="@Root/funds" class="@Active("funds")" aria-current="@Current("funds")">Funds</a>
                    <a href="@Root/outlook" class="@Active("outlook")" aria-current="@Current("outlook")">Outlook</a>
                    <a href="@Root/years" class="@Active("years")" aria-current="@Current("years")">Year over year</a>
                    <a href="@Root/search" class="@Active("search")" aria-current="@Current("search")">Search</a>
                </nav>
            }
        </div>
    </header>

    <main class="pt-in pt-main" id="main">
        @* Whether this portal takes questions, worked out once here, so a page can offer the question box without asking again. *@
        <CascadingValue Name="PortalAskable" Value="askable">
            @Body
        </CascadingValue>
    </main>

    @if (ShowBuddy)
    {
        <PortalBuddy Budget="budget!" Root="@Root" />
    }

    <footer class="pt-foot">
        <div class="pt-in pt-foot-in">
            @if (budget is not null)
            {
                <span>@budget.GovernmentName · FY@(budget.FiscalYear) @budget.VersionLabel@(budget.ResolutionNumber is null ? "" : $", resolution {budget.ResolutionNumber}") · published @Display.LongDate(budget.PublishedAtUtc)</span>
                @if (budget.HasBook)
                {
                    <a href="@Root/budget-book.pdf">Budget book (PDF)</a>
                }
                <a href="@Root/download.csv">Download CSV</a>
                <a href="@Root/download.xlsx">Download Excel</a>
                <a href="@Root/glossary">Glossary</a>
                <a href="@Root/glossary#accessibility">Accessibility</a>
            }
        </div>
    </footer>
</div>

@code {
    private PortalRoute? route;
    private PortalBudgetDto? budget;
    private bool askable;

    private string Root => route is null ? "/transparency" : $"/transparency/{route.Slug}/{budget?.FiscalYear ?? route.Year}";

    protected override async Task OnInitializedAsync()
    {
        route = PortalRoutes.Parse(new Uri(Navigation.Uri));
        if (route is not null)
        {
            budget = await Snapshots.GetBudgetAsync(route.Slug, route.Year);

            // Checked only when a model is connected, so a portal without one reads nothing more.
            askable = budget is not null && Questions.ModelConfigured && await Questions.IsAvailableAsync(route.Slug);
        }
    }

    /// <summary>Marks the nav item for the current section (the third path segment after the year).</summary>
    private string Active(string section)
    {
        string[] segments = new Uri(Navigation.Uri).AbsolutePath.Trim('/').Split('/');
        string current = segments.Length >= 4 ? segments[3] : "";
        return current.Equals(section, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    // Civic Buddy floats on every page of a portal that takes questions, except the ask page, which is Civic Buddy itself.
    private bool ShowBuddy => askable && Active("ask") != "active";

    // The class shows the current section; aria-current tells a screen reader the same thing.
    private string? Current(string section) => Active(section) == "active" ? "page" : null;

}
