@inherits LayoutComponentBase

@* Public shell for the home page and the Account pages: a navy header bar and a plain page. *@
<a class="cb-skip" href="#main">Skip to content</a>
<header class="cb-public-header">
    <nav class="navbar navbar-dark">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="/"><Logo Size="28" Label="" /><span>CivicBudget</span></a>
            @* Signed out: nothing in the bar (not even an empty list). Every public page carries its own Sign in control. *@
            <AuthorizeView>
                <Authorized>
                    <ul class="navbar-nav flex-row gap-3">
                        <li class="nav-item"><NavLink class="nav-link" href="admin">Admin</NavLink></li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit" class="btn btn-link nav-link">Log out</button>
                            </form>
                        </li>
                    </ul>
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>
</header>

<main id="main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet role="alert">
    Something went wrong and this page stopped responding. <a href="" class="reload">Reload</a> to continue.
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>
