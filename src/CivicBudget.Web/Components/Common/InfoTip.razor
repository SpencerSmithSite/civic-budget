@* A small "i" that reveals a sentence on hover or keyboard focus. This is where explanatory text
   goes now (Phase 8): the screen shows the data, the tip explains it when someone wants that.
   CSS only, no Bootstrap tooltip JS; the text is also the accessible name, so a screen reader
   hears it without hovering. *@
<span class="cb-tip" tabindex="0" role="note" aria-label="@Text">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    <span class="cb-tip-text" aria-hidden="true">@Text</span>
</span>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";
}
