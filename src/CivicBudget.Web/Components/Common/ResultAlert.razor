@* A failed Result as one error summary: every message, the field ones included (each also shows
   beside its field). When a new failure arrives the summary takes focus, so a keyboard or screen
   reader user lands on what went wrong instead of staying on the Save button (WCAG 3.3.1). *@
@if (Result is { IsFailure: true } && Result.Errors.Count > 0)
{
    <div class="alert alert-danger" role="alert" tabindex="-1" @ref="box">
        @if (Result.Errors.Count == 1)
        {
            @Result.Errors[0].Message
        }
        else
        {
            <ul class="mb-0">
                @foreach (var error in Result.Errors)
                {
                    <li>@error.Message</li>
                }
            </ul>
        }
    </div>
}

@code {
    private ElementReference box;
    private Result? shown;
    private bool focusPending;

    [Parameter]
    public Result? Result { get; set; }

    protected override void OnParametersSet()
    {
        // Only a new failure moves focus; a re-render of the same one leaves the user where they are.
        if (!ReferenceEquals(Result, shown))
        {
            shown = Result;
            focusPending = Result is { IsFailure: true };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending && Result is { IsFailure: true } && Result.Errors.Count > 0)
        {
            focusPending = false;
            await box.FocusAsync();
        }
    }
}
