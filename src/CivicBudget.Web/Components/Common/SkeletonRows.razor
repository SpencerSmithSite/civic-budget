@* Placeholder rows shown inside a grid while data loads, so the page keeps its shape. *@
@* The placeholder is hidden from screen readers, which hear "Loading" instead. *@
<span class="visually-hidden" role="status">Loading</span>
<table class="cb-grid" aria-hidden="true">
    <tbody>
        @for (int i = 0; i < Rows; i++)
        {
            <tr class="cb-skeleton">
                @for (int c = 0; c < Columns; c++)
                {
                    <td><span style="width:@(Widths[(i + c) % Widths.Length])"></span></td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    private static readonly string[] Widths = ["60%", "40%", "75%", "30%", "55%"];

    [Parameter]
    public int Rows { get; set; } = 5;

    [Parameter]
    public int Columns { get; set; } = 4;
}
