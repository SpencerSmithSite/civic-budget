@inject AdminPageState PageState

@* Eyebrow, title, optional pill, subtitle, and a right-aligned action area. Also publishes the
   breadcrumb trail to the top bar so pages declare it in one place. *@
<div class="cb-page-header">
    <div>
        @if (!string.IsNullOrEmpty(Eyebrow))
        {
            <div class="cb-eyebrow">@Eyebrow</div>
        }
        @* The pill and tip sit beside the h1, not in it: each navigation focuses the h1, and a heading
           that contained them would be read as the title plus a status plus a paragraph of help. *@
        <div class="cb-page-title">
            <h1>@Title</h1>
            @TitleAddon
            @if (Tip is not null) { <InfoTip Text="@Tip" /> }
        </div>
        @if (Subtitle is not null)
        {
            <div class="cb-sub">@Subtitle</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="cb-page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public RenderFragment? TitleAddon { get; set; }

    /// <summary>One line of data under the title (an amendment reason, a date). Not for explaining the page; use <see cref="Tip"/>.</summary>
    [Parameter]
    public RenderFragment? Subtitle { get; set; }

    /// <summary>What the page is for, shown on demand beside the title.</summary>
    [Parameter]
    public string? Tip { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Breadcrumb trail; the last crumb is the current page and needs no link.</summary>
    [Parameter]
    public Crumb[]? Crumbs { get; set; }

    protected override void OnParametersSet()
    {
        if (Crumbs is not null)
        {
            PageState.SetCrumbs(Crumbs);
        }
    }
}
