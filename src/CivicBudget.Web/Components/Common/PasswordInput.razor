@inherits InputText
@* A password field with a show/hide button inside its right edge. It is an InputText underneath,
   so it binds, validates, and posts (on the static sign-in page) exactly like one. The button
   works through password-toggle.js rather than a Blazor event, because the sign-in and
   change-password pages are plain static HTML with no circuit to handle a click; the same script
   serves the interactive user form. Without script the button stays hidden and the field is an
   ordinary password box. *@
<div class="cb-password">
    <input @attributes="AdditionalAttributes" type="password" name="@NameAttributeValue" class="@CssClass" @bind="CurrentValueAsString" />
    <button type="button" class="cb-password-toggle" data-password-toggle aria-controls="@InputId" aria-pressed="false" aria-label="Show password">
        <i class="bi bi-eye" aria-hidden="true"></i>
    </button>
</div>

@code {
    /// <summary>The input's id, which the button names so assistive tech knows what it reveals.</summary>
    private string? InputId => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("id", out object? id) ? id?.ToString() : null;
}
