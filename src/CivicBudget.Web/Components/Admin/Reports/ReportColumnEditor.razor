@using CivicBudget.Application.Reports
@using CivicBudget.Domain.Reports

@* A report's columns as named sets of accounts, each account in at most one column. Used for the
   certificate's revenue columns and the appropriation measure's expenditure columns. An account in
   another column is disabled here and says where it is; the service refuses it anyway. *@
<div class="d-flex align-items-center gap-2 mb-2">
    <h2 class="h6 mb-0 flex-grow-1">@Title</h2>
    @if (UsingDefault)
    {
        <StatusPill Tone="info" Label="@DefaultNote" />
    }
    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="Add" disabled="@(Columns.Count >= ReportColumnRules.MaxColumns)">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add column
    </button>
</div>

@if (Columns.Count == 0)
{
    <div class="card mb-4"><EmptyState Icon="bi-layout-three-columns" Title="No columns" Text="@($"Every amount is counted under {OtherLabel}.")" /></div>
}

<div class="cb-column-cards mb-4">
    @for (int i = 0; i < Columns.Count; i++)
    {
        int index = i;
        ReportColumnForm column = Columns[index];
        <div class="card" @key="column">
            <div class="card-body">
                <div class="d-flex gap-2 align-items-end mb-3">
                    <div class="flex-grow-1">
                        <label class="form-label fw-semibold" for="@($"{IdPrefix}column{index}")">Column heading</label>
                        <input id="@($"{IdPrefix}column{index}")" class="form-control" maxlength="@ReportAccountGroup.LabelMaxLength" @bind="column.Label" @bind:event="oninput" @bind:after="Changed" />
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => Remove(index)" aria-label="@($"Remove the {column.Label} column")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                </div>
                <fieldset>
                    <legend class="form-label">Accounts in this column</legend>
                    <div class="cb-account-checks">
                        @foreach (ReportAccountDto account in Accounts)
                        {
                            ReportColumnForm? elsewhere = Columns.FirstOrDefault(c => c != column && c.AccountIds.Contains(account.Id));
                            string id = $"{IdPrefix}c{index}-{account.Id:N}";
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@id" checked="@column.AccountIds.Contains(account.Id)" disabled="@(elsewhere is not null)"
                                       @onchange="e => Toggle(column, account.Id, e.Value is true)" />
                                <label class="form-check-label" for="@id">
                                    <span class="cb-code">@account.Code</span> @account.Name
                                    @if (elsewhere is not null)
                                    {
                                        <span class="small text-secondary">(in @elsewhere.Label)</span>
                                    }
                                    else if (!account.IsActive)
                                    {
                                        <span class="small text-secondary">(inactive)</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public List<ReportColumnForm> Columns { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ReportAccountDto> Accounts { get; set; } = [];

    /// <summary>The heading of the last column, where everything not in a column goes.</summary>
    [Parameter, EditorRequired]
    public string OtherLabel { get; set; } = "";

    [Parameter]
    public bool UsingDefault { get; set; }

    [Parameter]
    public string DefaultNote { get; set; } = "";

    /// <summary>The heading a first new column starts with.</summary>
    [Parameter]
    public string FirstLabel { get; set; } = "";

    /// <summary>Keeps element ids unique when two editors share a page.</summary>
    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = "";

    /// <summary>Raised on every change, so a preview elsewhere on the page can follow.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task Changed() => OnChanged.InvokeAsync();

    private Task Add()
    {
        Columns.Add(new ReportColumnForm { Label = Columns.Count == 0 ? FirstLabel : "" });
        return Changed();
    }

    private Task Remove(int index)
    {
        Columns.RemoveAt(index);
        return Changed();
    }

    private Task Toggle(ReportColumnForm column, Guid accountId, bool on)
    {
        if (on)
        {
            column.AccountIds.Add(accountId);
        }
        else
        {
            column.AccountIds.Remove(accountId);
        }

        return Changed();
    }
}
