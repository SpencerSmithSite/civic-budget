@page "/admin/report-settings"
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@using CivicBudget.Application.Reports
@using CivicBudget.Domain.Reports
@inject ICertificateService Certificates
@inject ToastService Toasts

@* Which accounts a report counts where, per government. Charts differ: one village's "taxes" are
   real estate and income tax, a township's are real estate and a road levy. The certificate of
   estimated resources is the first report that needs this; its preview row shows the columns
   exactly as the certificate will print them. *@
<PageTitle>Report settings</PageTitle>

<PageHeader Title="Report settings" Eyebrow="Setup" Crumbs="@([new Crumb("Setup"), new Crumb("Report settings")])"
            Tip="Tells the reports which of your accounts go where. Revenue accounts not in any column are counted under the last heading, so no receipt is left out." />

@if (form is null)
{
    <SkeletonRows Rows="5" Columns="3" />
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 mb-1">Certificate of estimated resources</h2>
            <p class="small text-secondary mb-3">What the certificate prints that the budget does not say, and its column headings as your county auditor's template words them.</p>

            <div class="cb-settings-grid">
                <div>
                    <label class="form-label fw-semibold" for="county">County</label>
                    <div class="input-group">
                        <input id="county" class="form-control" maxlength="@CertificateSettings.NameMaxLength" @bind="form.County" placeholder="Harmon" />
                        <span class="input-group-text">County</span>
                    </div>
                </div>
                <div>
                    <label class="form-label fw-semibold" for="officerName">Prepared by</label>
                    <input id="officerName" class="form-control" maxlength="@CertificateSettings.NameMaxLength" @bind="form.FiscalOfficerName" placeholder="Name on the signature line" />
                </div>
                <div>
                    <label class="form-label fw-semibold" for="officerTitle">Title</label>
                    <input id="officerTitle" class="form-control" maxlength="@CertificateSettings.NameMaxLength" @bind="form.FiscalOfficerTitle" />
                </div>
                <div>
                    <label class="form-label fw-semibold" for="balanceLabel">Balance heading</label>
                    <input id="balanceLabel" class="form-control" maxlength="@CertificateSettings.LabelMaxLength" @bind="form.BalanceLabel" @bind:event="oninput" />
                </div>
                <div>
                    <label class="form-label fw-semibold" for="otherLabel">Last revenue heading</label>
                    <input id="otherLabel" class="form-control" maxlength="@CertificateSettings.LabelMaxLength" @bind="form.OtherSourcesLabel" @bind:event="oninput" />
                    <div class="form-text">Every receipt not in a column below.</div>
                </div>
            </div>

            <div class="cb-cert-preview mt-4" aria-label="How the certificate's columns will read">
                <span>Fund</span>
                <span>@form.BalanceLabel</span>
                @foreach (ColumnForm column in form.Columns)
                {
                    <span class="cb-cert-preview-col">@(string.IsNullOrWhiteSpace(column.Label) ? "(no heading)" : column.Label)</span>
                }
                <span>@form.OtherSourcesLabel</span>
                <span>Total</span>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-2">
        <h2 class="h6 mb-0 flex-grow-1">Revenue columns</h2>
        @if (usingDefault)
        {
            <StatusPill Tone="info" Label="Ohio default: accounts categorized as taxes" />
        }
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddColumn" disabled="@(form.Columns.Count >= CertificateService.MaxColumns)">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add column
        </button>
    </div>

    @if (form.Columns.Count == 0)
    {
        <div class="card mb-4"><EmptyState Icon="bi-layout-three-columns" Title="No revenue columns" Text="@($"Every receipt is counted under {form.OtherSourcesLabel}. Add a column to show taxes separately.")" /></div>
    }

    <div class="cb-column-cards mb-4">
        @for (int i = 0; i < form.Columns.Count; i++)
        {
            int index = i;
            ColumnForm column = form.Columns[index];
            <div class="card" @key="column">
                <div class="card-body">
                    <div class="d-flex gap-2 align-items-end mb-3">
                        <div class="flex-grow-1">
                            <label class="form-label fw-semibold" for="@($"column{index}")">Column heading</label>
                            <input id="@($"column{index}")" class="form-control" maxlength="@ReportAccountGroup.LabelMaxLength" @bind="column.Label" @bind:event="oninput" />
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => form.Columns.RemoveAt(index)" aria-label="@($"Remove the {column.Label} column")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                    </div>
                    <fieldset>
                        <legend class="form-label">Accounts in this column</legend>
                        <div class="cb-account-checks">
                            @foreach (RevenueAccountDto account in settings!.RevenueAccounts)
                            {
                                ColumnForm? elsewhere = form.Columns.FirstOrDefault(c => c != column && c.AccountIds.Contains(account.Id));
                                string id = $"c{index}-{account.Id:N}";
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@id" checked="@column.AccountIds.Contains(account.Id)" disabled="@(elsewhere is not null)"
                                           @onchange="e => Toggle(column, account.Id, e.Value is true)" />
                                    <label class="form-check-label" for="@id">
                                        <span class="cb-code">@account.Code</span> @account.Name
                                        @if (elsewhere is not null)
                                        {
                                            <span class="small text-secondary">(in @elsewhere.Label)</span>
                                        }
                                        else if (!account.IsActive)
                                        {
                                            <span class="small text-secondary">(inactive)</span>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>
                </div>
            </div>
        }
    </div>

    @if (errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (string e in errors) { <li>@e</li> }</ul></div>
    }

    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@saving"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Save settings</button>
    </div>
}

@code {
    private CertificateSettingsDto? settings;
    private SettingsForm? form;
    private bool usingDefault;
    private bool saving;
    private List<string> errors = [];

    private sealed class SettingsForm
    {
        public string? County { get; set; }
        public string? FiscalOfficerName { get; set; }
        public string FiscalOfficerTitle { get; set; } = "";
        public string BalanceLabel { get; set; } = "";
        public string OtherSourcesLabel { get; set; } = "";
        public List<ColumnForm> Columns { get; } = [];
    }

    private sealed class ColumnForm
    {
        public string Label { get; set; } = "";
        public HashSet<Guid> AccountIds { get; } = [];
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        settings = await Certificates.GetSettingsAsync();
        usingDefault = settings.UsingDefaultColumns;
        form = new SettingsForm
        {
            County = settings.County,
            FiscalOfficerName = settings.FiscalOfficerName,
            FiscalOfficerTitle = settings.FiscalOfficerTitle,
            BalanceLabel = settings.BalanceLabel,
            OtherSourcesLabel = settings.OtherSourcesLabel,
        };
        foreach (ReportColumnDto column in settings.Columns)
        {
            var c = new ColumnForm { Label = column.Label };
            c.AccountIds.UnionWith(column.AccountIds);
            form.Columns.Add(c);
        }
    }

    private void AddColumn() => form!.Columns.Add(new ColumnForm { Label = form.Columns.Count == 0 ? "Taxes" : "" });

    private static void Toggle(ColumnForm column, Guid accountId, bool on)
    {
        if (on)
        {
            column.AccountIds.Add(accountId);
        }
        else
        {
            column.AccountIds.Remove(accountId);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            Result result = await Certificates.SaveSettingsAsync(new SaveCertificateSettingsRequest(
                form!.County, form.FiscalOfficerName, form.FiscalOfficerTitle, form.BalanceLabel, form.OtherSourcesLabel,
                form.Columns.Select(c => new ReportColumnDto(c.Label, c.AccountIds.ToList())).ToList()));
            errors = result.IsFailure ? result.Errors.Select(e => e.Message).ToList() : [];
            if (result.IsSuccess)
            {
                Toasts.Success("Report settings saved.");
                await LoadAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }
}
