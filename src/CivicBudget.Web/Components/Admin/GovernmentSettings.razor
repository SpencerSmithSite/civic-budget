@page "/admin/settings"
@attribute [Authorize(Policy = Policies.CanManageUsers)]
@inject IGovernmentSettingsService SettingsService
@inject IGovernmentLogoService Logos
@inject ToastService Toasts
@using CivicBudget.Application.Portal

<PageTitle>Government settings</PageTitle>

<PageHeader Title="Government settings" Eyebrow="Administration" Crumbs="@([new Crumb("Administration"), new Crumb("Government settings")])">
</PageHeader>

@if (current is null)
{
    <SkeletonRows Rows="6" Columns="2" />
}
else
{
    <div class="card"><div class="card-body" style="max-width: 640px">
    <ResultAlert Result="result" />
    <EditForm EditContext="editContext" OnSubmit="SaveAsync">
        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" class="text-danger" />
        </div>
        <div class="row mb-3">
            <div class="col">
                <label class="form-label">Type</label>
                <input class="form-control" value="@Display.Enum(current.Type)" disabled />
            </div>
            <div class="col">
                <label class="form-label">State</label>
                <input class="form-control" value="@current.State" disabled />
            </div>
            <div class="col">
                <label class="form-label">Fiscal year starts</label>
                <input class="form-control" value="@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(current.FiscalYearStartMonth)" disabled />
            </div>
            <div class="form-text">Type, state, and fiscal year start are fixed once fiscal years exist, because existing years' dates depend on them.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="slug">Public address</label>
            <div class="input-group">
                <span class="input-group-text">/transparency/</span>
                <InputText id="slug" class="form-control" @bind-Value="model.PublicSlug" />
            </div>
            <ValidationMessage For="() => model.PublicSlug" class="text-danger" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="mode">When a fund's appropriations exceed its estimated resources</label>
            <InputSelect id="mode" class="form-select" @bind-Value="model.AppropriationLimitMode">
                <option value="@AppropriationLimitMode.Block">Block proposing and adopting</option>
                <option value="@AppropriationLimitMode.Warn">Warn, allow after acknowledgement</option>
            </InputSelect>
            <div class="form-text">Ohio law caps appropriations at certified estimated resources; Block is the safe default. Warn shows the overage and lets the fiscal officer acknowledge it and continue.</div>
        </div>
        <fieldset class="mb-3 cb-number-format">
            <legend class="form-label">Account number format <InfoTip Text="How the parent ERP writes a full account number: fund, then the program or department, then the object. A UAN village writes 1000-725-121 (4-3-3); many county charts write 101-110-5100 (3-3-4). Revenue lines skip the middle segment." /></legend>
            <div class="cb-number-format-row">
                <div><label class="form-label small" for="fundWidth">Fund digits</label><InputNumber id="fundWidth" class="form-control" @bind-Value="model.FundWidth" min="1" max="8" /></div>
                <div><label class="form-label small" for="deptWidth">@model.DepartmentLabel digits</label><InputNumber id="deptWidth" class="form-control" @bind-Value="model.DepartmentWidth" min="1" max="8" /></div>
                <div><label class="form-label small" for="objWidth">Object digits</label><InputNumber id="objWidth" class="form-control" @bind-Value="model.ObjectWidth" min="1" max="8" /></div>
                <div><label class="form-label small" for="separator">Separator</label><InputText id="separator" class="form-control" @bind-Value="model.Separator" maxlength="1" /></div>
                <div><label class="form-label small" for="deptLabel">Middle segment is called</label>
                    <InputSelect id="deptLabel" class="form-select" @bind-Value="model.DepartmentLabel">
                        <option value="Program">Program (UAN)</option>
                        <option value="Department">Department</option>
                    </InputSelect>
                </div>
            </div>
            <div class="form-text">Looks like: <span class="cb-code">@Example</span> for an expenditure and <span class="cb-code">@RevenueExample</span> for a revenue.</div>
            <ValidationMessage For="() => model.Separator" class="text-danger" />
        </fieldset>
        <div class="mb-3">
            <label class="form-label" for="description">Introduction shown to citizens on the public portal</label>
            <InputTextArea id="description" class="form-control" rows="4" @bind-Value="model.Description" />
            <ValidationMessage For="() => model.Description" class="text-danger" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@saving">Save settings</button>
    </EditForm>
    </div></div>

    <div class="card mt-3" style="max-width: 640px">
        <div class="card-header d-flex align-items-center gap-2">Logo on the public portal <InfoTip Text="Shown in the portal header in place of the CivicBudget mark. Resized to 512 pixels in your browser before upload; a square or near-square image fits best." /></div>
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <span class="pt-logo-preview">
                @if (logo is not null)
                {
                    <img src="@LogoDataUrl" alt="Current logo" />
                }
                else
                {
                    <Logo Size="56" Label="CivicBudget mark, the default" />
                }
            </span>
            <div class="flex-grow-1">
                <ResultAlert Result="logoResult" />
                <label class="form-label fw-semibold" for="logo">Choose an image</label>
                <InputFile id="logo" class="form-control" accept="image/*" OnChange="UploadLogoAsync" disabled="@logoBusy" />
                @if (logo is not null)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm mt-3" @onclick="RemoveLogoAsync" disabled="@logoBusy"><i class="bi bi-trash me-1" aria-hidden="true"></i>Use the CivicBudget mark instead</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private GovernmentSettingsDto? current;
    private readonly FormModel model = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private Result? result;
    private bool saving;
    private PortalLogoDto? logo;
    private Result? logoResult;
    private bool logoBusy;

    private string LogoDataUrl => logo is null ? "" : $"data:{logo.ContentType};base64,{Convert.ToBase64String(logo.Data)}";

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        messages = new ValidationMessageStore(editContext);

        current = await SettingsService.GetAsync();
        logo = await Logos.GetAsync();
        model.Name = current.Name;
        model.PublicSlug = current.PublicSlug;
        model.AppropriationLimitMode = current.AppropriationLimitMode;
        model.Description = current.Description;
        model.FundWidth = current.AccountNumberFormat.FundWidth;
        model.DepartmentWidth = current.AccountNumberFormat.DepartmentWidth;
        model.ObjectWidth = current.AccountNumberFormat.ObjectWidth;
        model.Separator = current.AccountNumberFormat.Separator;
        model.DepartmentLabel = current.AccountNumberFormat.DepartmentLabel;
    }

    private string Example => string.Join(model.Separator, new[] { new string('1', model.FundWidth), new string('7', model.DepartmentWidth), new string('5', model.ObjectWidth) });
    private string RevenueExample => string.Join(model.Separator, new[] { new string('1', model.FundWidth), new string('4', model.ObjectWidth) });

    private async Task SaveAsync()
    {
        saving = true;
        Result saved = await SettingsService.UpdateAsync(new UpdateGovernmentSettingsRequest(model.Name, model.PublicSlug, model.AppropriationLimitMode, model.Description,
            model.FundWidth, model.DepartmentWidth, model.ObjectWidth, model.Separator, model.DepartmentLabel));
        saving = false;

        result = saved.IsSuccess ? null : saved;
        editContext.ApplyErrors(messages, saved);
        if (saved.IsSuccess)
        {
            Toasts.Success("Settings saved.");
            current = await SettingsService.GetAsync();
        }
    }

    private async Task UploadLogoAsync(InputFileChangeEventArgs e)
    {
        logoBusy = true;
        logoResult = null;
        try
        {
            IBrowserFile resized = await e.File.RequestImageFileAsync("image/png", 512, 512);
            await using Stream stream = resized.OpenReadStream(UploadedImage.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            logoResult = await Logos.SetAsync(buffer.ToArray(), "image/png");
            if (logoResult.IsSuccess)
            {
                logo = await Logos.GetAsync();
                Toasts.Success("Logo updated. The portal shows it now.");
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            logoResult = Result.Failure("That file could not be read as an image. Choose a PNG, JPEG, or WebP picture.");
        }
        finally
        {
            logoBusy = false;
        }
    }

    private async Task RemoveLogoAsync()
    {
        logoBusy = true;
        logoResult = await Logos.RemoveAsync();
        if (logoResult.IsSuccess)
        {
            logo = null;
            Toasts.Success("The portal shows the CivicBudget mark again.");
        }

        logoBusy = false;
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string PublicSlug { get; set; } = "";
        public AppropriationLimitMode AppropriationLimitMode { get; set; }
        public string? Description { get; set; }
        public int FundWidth { get; set; } = 4;
        public int DepartmentWidth { get; set; } = 3;
        public int ObjectWidth { get; set; } = 4;
        public string Separator { get; set; } = "-";
        public string DepartmentLabel { get; set; } = "Program";
    }
}
