@page "/admin/settings"
@attribute [HelpTopic("Government settings", "The government's name, address, account number format, portal introduction and logo, two-step sign-in, the Civic Buddy (AI assistant) and portal-question switches, and downloading all its data.", "settings logo two-step mfa assistant civic buddy ai portal questions public export all data")]
@attribute [Authorize(Policy = Policies.CanManageUsers)]
@inject IGovernmentSettingsService SettingsService
@inject IGovernmentLogoService Logos
@inject ISignInSecurityService SignInSecurity
@inject CivicBudget.Application.Assistant.IAssistantService Assistant
@inject CivicBudget.Web.Components.Assistant.AssistantPanelState AssistantPanel
@inject ToastService Toasts
@using CivicBudget.Application.Portal

<PageTitle>Government settings</PageTitle>

<PageHeader Title="Government settings" Eyebrow="Administration" Crumbs="@([new Crumb("Administration"), new Crumb("Government settings")])">
</PageHeader>

@if (current is null)
{
    <SkeletonRows Rows="6" Columns="2" />
}
else
{
    <div class="card"><div class="card-body" style="max-width: 640px">
    <ResultAlert Result="result" />
    <EditForm EditContext="editContext" OnSubmit="SaveAsync">
        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" class="text-danger" />
        </div>
        <div class="row mb-3">
            <div class="col">
                <label class="form-label" for="gov-type">Type</label>
                <input class="form-control" id="gov-type" value="@Display.Enum(current.Type)" disabled />
            </div>
            <div class="col">
                <label class="form-label" for="gov-state">State</label>
                <input class="form-control" id="gov-state" value="@current.State" disabled />
            </div>
            <div class="col">
                <label class="form-label" for="gov-fy-start">Fiscal year starts</label>
                <input class="form-control" id="gov-fy-start" value="@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(current.FiscalYearStartMonth)" disabled />
            </div>
            <div class="form-text">Type, state, and fiscal year start are fixed once fiscal years exist, because existing years' dates depend on them.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="slug">Public address</label>
            <div class="input-group">
                <span class="input-group-text">/transparency/</span>
                <InputText id="slug" class="form-control" @bind-Value="model.PublicSlug" />
            </div>
            <ValidationMessage For="() => model.PublicSlug" class="text-danger" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="mode">When a fund's appropriations exceed its estimated resources</label>
            <InputSelect id="mode" class="form-select" @bind-Value="model.AppropriationLimitMode">
                <option value="@AppropriationLimitMode.Block">Block proposing and adopting</option>
                <option value="@AppropriationLimitMode.Warn">Warn, allow after acknowledgement</option>
            </InputSelect>
            <div class="form-text">Ohio law caps appropriations at certified estimated resources; Block is the safe default. Warn shows the overage and lets the fiscal officer acknowledge it and continue.</div>
        </div>
        <fieldset class="mb-3 cb-number-format">
            <legend class="form-label">Account number format <InfoTip Text="How the parent ERP writes a full account number: fund, then the program or department, then the object. A UAN village writes 1000-725-121 (4-3-3); many county charts write 101-110-5100 (3-3-4). Revenue lines skip the middle segment." /></legend>
            <div class="cb-number-format-row">
                <div><label class="form-label small" for="fundWidth">Fund digits</label><InputNumber id="fundWidth" class="form-control" @bind-Value="model.FundWidth" min="1" max="8" /></div>
                <div><label class="form-label small" for="deptWidth">@model.DepartmentLabel digits</label><InputNumber id="deptWidth" class="form-control" @bind-Value="model.DepartmentWidth" min="1" max="8" /></div>
                <div><label class="form-label small" for="objWidth">Object digits</label><InputNumber id="objWidth" class="form-control" @bind-Value="model.ObjectWidth" min="1" max="8" /></div>
                <div><label class="form-label small" for="separator">Separator</label><InputText id="separator" class="form-control" @bind-Value="model.Separator" maxlength="1" /></div>
                <div><label class="form-label small" for="deptLabel">Middle segment is called</label>
                    <InputSelect id="deptLabel" class="form-select" @bind-Value="model.DepartmentLabel">
                        <option value="Program">Program (UAN)</option>
                        <option value="Department">Department</option>
                    </InputSelect>
                </div>
            </div>
            <div class="form-text">Looks like: <span class="cb-code">@Example</span> for an expenditure and <span class="cb-code">@RevenueExample</span> for a revenue.</div>
            <ValidationMessage For="() => model.Separator" class="text-danger" />
        </fieldset>
        <div class="mb-3">
            <label class="form-label" for="description">Introduction shown to citizens on the public portal</label>
            <InputTextArea id="description" class="form-control" rows="4" @bind-Value="model.Description" />
            <ValidationMessage For="() => model.Description" class="text-danger" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@saving">Save settings</button>
    </EditForm>
    </div></div>

    <div class="card mt-3" style="max-width: 640px">
        <div class="card-header d-flex align-items-center gap-2">Sign-in security <InfoTip Text="Two-step sign-in asks for a six-digit code from an authenticator app after the password, so a stolen password alone is not enough. Anyone without it is signed out and set it up at their next sign-in." /></div>
        <div class="card-body">
            @if (security is not null)
            {
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="requireMfa" checked="@security.RequireMfa" @onchange="e => SetRequireMfaAsync(e.Value is true)" disabled="@securityBusy" />
                    <label class="form-check-label fw-semibold" for="requireMfa">Require two-step sign-in for everyone</label>
                </div>
                <div class="small text-secondary">@security.UsersWithMfa of @(security.UsersWithMfa + security.UsersWithoutMfa) users have it set up. Anyone can set it up for themselves under Your account.</div>
            }
        </div>
    </div>

    <div class="card mt-3" style="max-width: 640px">
        <div class="card-header d-flex align-items-center gap-2"><BuddyMark Size="20" />Civic Buddy <span class="cb-ai-badge">AI</span> <InfoTip Text="Civic Buddy is an AI assistant in the top bar that answers questions about your budget and actuals and helps people find their way around CivicBudget. It sees only what each user's account can see, and changes something only when the user confirms the change it proposes. Questions and the figures it looks up go to the AI model's provider." /></div>
        <div class="card-body">
            @if (assistant is null)
            {
                <SkeletonRows Rows="1" Columns="1" />
            }
            else if (!assistant.Configured)
            {
                <p class="small text-secondary mb-0">No AI model is connected to this CivicBudget. The operator connects one; after that you can turn Civic Buddy on here.</p>
            }
            else
            {
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="assistantEnabled" checked="@assistant.Enabled" @onchange="e => SetAssistantAsync(e.Value is true)" disabled="@assistantBusy" />
                    <label class="form-check-label fw-semibold" for="assistantEnabled">Let our users ask Civic Buddy</label>
                </div>
                <div class="small text-secondary">When on, a user's questions and the figures Civic Buddy looks up to answer them are sent to the AI model's provider. Each question is recorded in the security log, without its text.</div>

                <div class="form-check form-switch mb-2 mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="portalQuestionsEnabled" checked="@assistant.PortalQuestionsEnabled" @onchange="e => SetPortalQuestionsAsync(e.Value is true)" disabled="@assistantBusy" />
                    <label class="form-check-label fw-semibold" for="portalQuestionsEnabled">Let the public ask Civic Buddy on the transparency portal</label>
                </div>
                <div class="small text-secondary">When on, residents can ask about the published budget, and answers come only from what the portal already shows. Each portal takes a set number of questions a month; the question text is not kept.</div>
            }
        </div>
    </div>

    <div class="card mt-3" style="max-width: 640px">
        <div class="card-header d-flex align-items-center gap-2">Your data <InfoTip Text="Every table this government has, one CSV file each, in a ZIP: budgets, lines, positions, the chart, ERP data, users and their roles, the audit trail, and the security log. Passwords, two-step keys, and images are left out. The download is recorded in the security log." /></div>
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1 small text-secondary" style="min-width: 14rem">A complete copy of your government's data, to keep or to take elsewhere. Readable in any spreadsheet or database.</div>
            <a class="btn btn-outline-primary btn-sm" href="admin/export/government/all-data.zip" download><i class="bi bi-file-earmark-zip me-1" aria-hidden="true"></i>Download everything</a>
        </div>
    </div>

    <div class="card mt-3" style="max-width: 640px">
        <div class="card-header d-flex align-items-center gap-2">Logo on the public portal <InfoTip Text="Shown in the portal header in place of the CivicBudget mark. Resized to 512 pixels in your browser before upload; a square or near-square image fits best." /></div>
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <span class="pt-logo-preview">
                @if (logo is not null)
                {
                    <img src="@LogoDataUrl" alt="Current logo" />
                }
                else
                {
                    <Logo Size="56" Label="CivicBudget mark, the default" />
                }
            </span>
            <div class="flex-grow-1">
                <ResultAlert Result="logoResult" />
                <label class="form-label fw-semibold" for="logo">Choose an image</label>
                <InputFile id="logo" class="form-control" accept="image/*" OnChange="UploadLogoAsync" disabled="@logoBusy" />
                @if (logo is not null)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm mt-3" @onclick="RemoveLogoAsync" disabled="@logoBusy"><i class="bi bi-trash me-1" aria-hidden="true"></i>Use the CivicBudget mark instead</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private GovernmentSettingsDto? current;
    private readonly FormModel model = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private Result? result;
    private bool saving;
    private PortalLogoDto? logo;
    private Result? logoResult;
    private bool logoBusy;
    private SignInSecurityDto? security;
    private bool securityBusy;
    private CivicBudget.Application.Assistant.AssistantSettingsDto? assistant;
    private bool assistantBusy;

    private async Task SetAssistantAsync(bool enabled)
    {
        assistantBusy = true;
        try
        {
            Result saved = await Assistant.SetEnabledAsync(enabled);
            if (saved.IsSuccess)
            {
                Toasts.Success(enabled ? "Civic Buddy is on. It is in the top bar for every user." : "Civic Buddy is off.");
            }
            else
            {
                Toasts.Danger(saved.Errors[0].Message);
            }

            assistant = await Assistant.GetSettingsAsync();
            AssistantPanel.Refresh(await Assistant.StatusAsync());
        }
        finally
        {
            assistantBusy = false;
        }
    }

    private async Task SetPortalQuestionsAsync(bool enabled)
    {
        assistantBusy = true;
        try
        {
            Result saved = await Assistant.SetPortalQuestionsEnabledAsync(enabled);
            if (saved.IsSuccess)
            {
                Toasts.Success(enabled ? "The portal takes questions. Civic Buddy is in the corner of every page." : "The portal no longer takes questions.");
            }
            else
            {
                Toasts.Danger(saved.Errors[0].Message);
            }

            assistant = await Assistant.GetSettingsAsync();
        }
        finally
        {
            assistantBusy = false;
        }
    }

    private async Task SetRequireMfaAsync(bool require)
    {
        securityBusy = true;
        try
        {
            Result saved = await SignInSecurity.SetRequireMfaAsync(require);
            if (saved.IsSuccess)
            {
                Toasts.Success(require ? "Two-step sign-in is now required. Anyone without it sets it up at their next sign-in." : "Two-step sign-in is optional again.");
            }
            else
            {
                Toasts.Danger(saved.Errors[0].Message);
            }

            security = await SignInSecurity.GetAsync();
        }
        finally
        {
            securityBusy = false;
        }
    }

    private string LogoDataUrl => logo is null ? "" : $"data:{logo.ContentType};base64,{Convert.ToBase64String(logo.Data)}";

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        messages = new ValidationMessageStore(editContext);

        current = await SettingsService.GetAsync();
        logo = await Logos.GetAsync();
        security = await SignInSecurity.GetAsync();
        assistant = await Assistant.GetSettingsAsync();
        model.Name = current.Name;
        model.PublicSlug = current.PublicSlug;
        model.AppropriationLimitMode = current.AppropriationLimitMode;
        model.Description = current.Description;
        model.FundWidth = current.AccountNumberFormat.FundWidth;
        model.DepartmentWidth = current.AccountNumberFormat.DepartmentWidth;
        model.ObjectWidth = current.AccountNumberFormat.ObjectWidth;
        model.Separator = current.AccountNumberFormat.Separator;
        model.DepartmentLabel = current.AccountNumberFormat.DepartmentLabel;
    }

    // The preview renders while the user types, before the service validates the widths, so it
    // clamps them: new string('1', -1) throws, and a huge width would allocate a huge string.
    private string Example => string.Join(model.Separator, new[] { Digits('1', model.FundWidth), Digits('7', model.DepartmentWidth), Digits('5', model.ObjectWidth) });
    private string RevenueExample => string.Join(model.Separator, new[] { Digits('1', model.FundWidth), Digits('4', model.ObjectWidth) });

    private static string Digits(char digit, int width) => new(digit, Math.Clamp(width, 0, 12));

    private async Task SaveAsync()
    {
        saving = true;
        Result saved = await SettingsService.UpdateAsync(new UpdateGovernmentSettingsRequest(model.Name, model.PublicSlug, model.AppropriationLimitMode, model.Description,
            model.FundWidth, model.DepartmentWidth, model.ObjectWidth, model.Separator, model.DepartmentLabel));
        saving = false;

        result = saved.IsSuccess ? null : saved;
        editContext.ApplyErrors(messages, saved);
        if (saved.IsSuccess)
        {
            Toasts.Success("Settings saved.");
            current = await SettingsService.GetAsync();
        }
    }

    private async Task UploadLogoAsync(InputFileChangeEventArgs e)
    {
        logoBusy = true;
        logoResult = null;
        try
        {
            IBrowserFile resized = await e.File.RequestImageFileAsync("image/png", 512, 512);
            await using Stream stream = resized.OpenReadStream(UploadedImage.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            logoResult = await Logos.SetAsync(buffer.ToArray(), "image/png");
            if (logoResult.IsSuccess)
            {
                logo = await Logos.GetAsync();
                Toasts.Success("Logo updated. The portal shows it now.");
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            logoResult = Result.Failure("That file could not be read as an image. Choose a PNG, JPEG, or WebP picture.");
        }
        finally
        {
            logoBusy = false;
        }
    }

    private async Task RemoveLogoAsync()
    {
        logoBusy = true;
        logoResult = await Logos.RemoveAsync();
        if (logoResult.IsSuccess)
        {
            logo = null;
            Toasts.Success("The portal shows the CivicBudget mark again.");
        }

        logoBusy = false;
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string PublicSlug { get; set; } = "";
        public AppropriationLimitMode AppropriationLimitMode { get; set; }
        public string? Description { get; set; }
        public int FundWidth { get; set; } = 4;
        public int DepartmentWidth { get; set; } = 3;
        public int ObjectWidth { get; set; } = 4;
        public string Separator { get; set; } = "-";
        public string DepartmentLabel { get; set; } = "Program";
    }
}
