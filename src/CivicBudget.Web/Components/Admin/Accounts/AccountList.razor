@page "/admin/accounts"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@inject IAccountService AccountService
@inject IJSRuntime JS

<PageTitle>Chart of accounts</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Chart of accounts</h1>
    <a class="btn btn-primary" href="admin/accounts/new">New account</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" placeholder="Search code or name" @bind="search" @bind:event="oninput" aria-label="Search accounts" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="typeFilter" aria-label="Filter by account type">
            <option value="">All types</option>
            @foreach (AccountType type in Enum.GetValues<AccountType>())
            {
                <option value="@type">@Display.Enum(type)</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="includeInactive" @bind="includeInactive" @bind:after="LoadAsync" />
            <label class="form-check-label" for="includeInactive">Show inactive</label>
        </div>
    </div>
</div>

@if (accounts is null)
{
    <p>Loading...</p>
}
else
{
    <QuickGrid Items="Filtered" Class="table table-striped table-hover" Pagination="pagination">
        <PropertyColumn Property="a => a.Code" Sortable="true" />
        <PropertyColumn Property="a => a.Name" Sortable="true" />
        <TemplateColumn Title="Type" SortBy="GridSort<AccountDto>.ByAscending(a => a.Type)">@Display.Enum(context.Type)</TemplateColumn>
        <TemplateColumn Title="Category" SortBy="GridSort<AccountDto>.ByAscending(a => a.Category)">@Display.Enum(context.Category)</TemplateColumn>
        <TemplateColumn Title="Status">
            @if (context.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }
        </TemplateColumn>
        <TemplateColumn Title="" Align="Align.End">
            <a class="btn btn-sm btn-outline-primary" href="admin/accounts/@context.Id">Edit</a>
            @if (context.IsActive)
            {
                <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => SetActiveAsync(context, false)">Deactivate</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => SetActiveAsync(context, true)">Reactivate</button>
            }
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
}

@code {
    private IReadOnlyList<AccountDto>? accounts;
    private string search = "";
    private string typeFilter = "";
    private bool includeInactive;
    private readonly PaginationState pagination = new() { ItemsPerPage = 25 };

    private IQueryable<AccountDto> Filtered => (accounts ?? [])
        .Where(a => string.IsNullOrWhiteSpace(search)
            || a.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
            || a.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(a => string.IsNullOrEmpty(typeFilter) || a.Type.ToString() == typeFilter)
        .AsQueryable();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => accounts = await AccountService.ListAsync(includeInactive);

    private async Task SetActiveAsync(AccountDto account, bool isActive)
    {
        string verb = isActive ? "Reactivate" : "Deactivate";
        if (!await JS.InvokeAsync<bool>("confirm", $"{verb} account {account.Code} {account.Name}?"))
        {
            return;
        }

        await AccountService.SetActiveAsync(account.Id, isActive);
        await LoadAsync();
    }
}
