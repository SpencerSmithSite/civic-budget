@page "/admin/accounts"
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@inject IAccountService AccountService
@inject ToastService Toasts
@inject CivicBudget.Application.Erp.IChartSyncService ChartSync
@using CivicBudget.Web.Components.Admin.Chart

<PageTitle>Chart of accounts</PageTitle>

<PageHeader Title="Chart of accounts" Eyebrow="Setup" Crumbs="@([new Crumb("Setup"), new Crumb("Chart of accounts")])" Tip="Every account rolls up to a reporting category, which decides where it appears in reports and on the public portal.">
    <Actions><a class="btn btn-outline-primary btn-sm" href="admin/export/setup/accounts.xlsx"><i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Export XLSX</a>@if (!erpManaged) { <a class="btn btn-primary btn-sm" href="admin/accounts/new"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New account</a> }</Actions>
</PageHeader>

<ChartSourceBanner Status="chartStatus" />

<div class="card">
    <div class="cb-toolbar">
        <input class="form-control" placeholder="Search code or name" @bind="search" @bind:event="oninput" @bind:after="FirstPageAsync" aria-label="Search accounts" />
        <select class="form-select" @bind="typeFilter" aria-label="Filter by account type">
            <option value="">All types</option>
            @foreach (AccountType type in Enum.GetValues<AccountType>())
            {
                <option value="@type">@Display.Enum(type)</option>
            }
        </select>
        <div class="form-check ms-2">
            <input class="form-check-input" type="checkbox" id="includeInactive" @bind="includeInactive" @bind:after="LoadAsync" />
            <label class="form-check-label small" for="includeInactive">Show inactive</label>
        </div>
    </div>
    @if (accounts is null)
    {
        <SkeletonRows Rows="8" Columns="5" />
    }
    else if (!Filtered.Any())
    {
        <EmptyState Icon="bi-list-columns" Title="@(accounts.Count == 0 ? "No accounts yet" : "No accounts match")" Text="@(accounts.Count == 0 ? "Add revenue and expenditure accounts before entering a budget." : "Try a different search or type.")" />
    }
    else
    {
        <div class="cb-grid-wrap d-none d-md-block">
            <QuickGrid Items="Filtered" Theme="bootstrap" Class="cb-grid" Pagination="pagination">
                <PropertyColumn Property="a => a.Code" Sortable="true" />
                <PropertyColumn Property="a => a.Name" Sortable="true" Class="cb-wrap" />
                <TemplateColumn Title="Type" SortBy="GridSort<AccountDto>.ByAscending(a => a.Type)">@Display.Enum(context.Type)</TemplateColumn>
                <TemplateColumn Title="Category" SortBy="GridSort<AccountDto>.ByAscending(a => a.Category)">@Display.Enum(context.Category)</TemplateColumn>
                <TemplateColumn Title="Status">@StatusOf(context)</TemplateColumn>
                <TemplateColumn Title="" Align="Align.End">@RowActions(context)</TemplateColumn>
            </QuickGrid>
        </div>
        <div class="cb-cards d-md-none">
            @foreach (AccountDto account in Page)
            {
                <ListCard Code="@account.Code" Title="@account.Name" Summary="@MetaOf(account)" Aside="@StatusOf(account)" Menu="@RowActions(account)" />
            }
        </div>
        <div class="cb-grid-foot"><span>@Filtered.Count() accounts</span><ListPager State="pagination" Noun="Accounts" PageChanged="StateHasChanged" /></div>
    }
</div>

<ConfirmDialog @ref="dialog" Title="@($"{(pendingActive ? "Reactivate" : "Deactivate")} {pending?.Code} {pending?.Name}?")" ConfirmText="@(pendingActive ? "Reactivate" : "Deactivate")" ConfirmClass="@(pendingActive ? "btn-primary" : "btn-danger")" OnConfirm="ConfirmAsync">
    <Body><p>@(pendingActive ? "The account will be available on new budget lines again." : "Existing budget lines keep their history; new lines cannot use this account.")</p></Body>
</ConfirmDialog>

@code {
    private CivicBudget.Application.Erp.ChartSourceStatusDto? chartStatus;
    private bool erpManaged => chartStatus?.Source == CivicBudget.Domain.Erp.ChartSource.Erp;

    private IReadOnlyList<AccountDto>? accounts;
    private string search = "";
    private string typeFilter = "";
    private bool includeInactive;
    private readonly PaginationState pagination = new() { ItemsPerPage = 25 };
    private ConfirmDialog dialog = default!;
    private AccountDto? pending;
    private bool pendingActive;

    private IQueryable<AccountDto> Filtered => (accounts ?? [])
        .Where(a => string.IsNullOrWhiteSpace(search)
            || a.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
            || a.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(a => string.IsNullOrEmpty(typeFilter) || a.Type.ToString() == typeFilter)
        .AsQueryable();

    private IEnumerable<AccountDto> Page => Filtered.Skip(pagination.CurrentPageIndex * pagination.ItemsPerPage).Take(pagination.ItemsPerPage);

    private static RenderFragment MetaOf(AccountDto account) => @<text>@Display.Enum(account.Type) · @Display.Enum(account.Category)</text>;

    private static RenderFragment StatusOf(AccountDto account) => account.IsActive
        ? @<StatusPill Tone="success" Label="Active" />
        : @<StatusPill Label="Inactive" />;

    private RenderFragment? RowActions(AccountDto account) => erpManaged ? null : @<RowMenu Label="@($"Actions for {account.Code}")">
        <li><a class="dropdown-item" href="admin/accounts/@account.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit</a></li>
        <li><hr class="dropdown-divider"></li>
        @if (account.IsActive)
        {
            <li><button type="button" class="dropdown-item" @onclick="() => Ask(account, false)"><i class="bi bi-archive me-2" aria-hidden="true"></i>Deactivate</button></li>
        }
        else
        {
            <li><button type="button" class="dropdown-item" @onclick="() => Ask(account, true)"><i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>Reactivate</button></li>
        }
    </RowMenu>;

    protected override async Task OnInitializedAsync()
    {
        chartStatus = await ChartSync.StatusAsync();
        await LoadAsync();
    }

    private Task FirstPageAsync() => pagination.SetCurrentPageIndexAsync(0);

    private async Task LoadAsync() => accounts = await AccountService.ListAsync(includeInactive);

    private void Ask(AccountDto account, bool isActive)
    {
        pending = account;
        pendingActive = isActive;
        dialog.Show();
    }

    private async Task<bool> ConfirmAsync()
    {
        if (pending is null)
        {
            return true;
        }

        Result result = await AccountService.SetActiveAsync(pending.Id, pendingActive);
        if (result.IsSuccess)
        {
            Toasts.Success($"{pending.Code} {pending.Name} {(pendingActive ? "reactivated" : "deactivated")}.");
        }
        else
        {
            Toasts.Danger(result.Errors[0].Message);
        }

        await LoadAsync();
        // OnConfirm is a Func, not an EventCallback, so Blazor does not re-render this page after it.
        StateHasChanged();
        return true;
    }
}
