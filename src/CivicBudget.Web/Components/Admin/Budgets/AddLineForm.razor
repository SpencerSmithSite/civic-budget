@using CivicBudget.Domain.Accounts
@* Adds a line to the open version, inside a ConfirmDialog opened from the grid toolbar. *@
<ConfirmDialog @ref="dialog" Title="Add a budget line" ConfirmText="Add line" OnConfirm="SubmitAsync" ConfirmDisabled="@(fundId == "" || accountId == "")">
    <Body>
        <ResultAlert Result="result" />
        <div class="mb-3">
            <label class="form-label fw-semibold" for="add-fund">Fund</label>
            <select id="add-fund" class="form-select" @bind="fundId">
                <option value="">Choose a fund</option>
                @foreach (LookupDto fund in Workspace.Funds)
                {
                    <option value="@fund.Id">@fund.Display</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="add-account">Account</label>
            <select id="add-account" class="form-select" @bind="accountId">
                <option value="">Choose an account</option>
                @foreach (AccountLookupDto account in Workspace.Accounts)
                {
                    <option value="@account.Id">@account.Display (@Display.Enum(account.Type))</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="add-dept">Department</label>
            <select id="add-dept" class="form-select" @bind="departmentId">
                <option value="">None (fund level, for revenues and transfers)</option>
                @foreach (LookupDto department in Workspace.Departments)
                {
                    <option value="@department.Id">@department.Display</option>
                }
            </select>
            <div class="form-text">Expenditure accounts need a department.</div>
        </div>
        <div class="mb-1">
            <label class="form-label fw-semibold" for="add-amount">Proposed amount</label>
            <input id="add-amount" type="text" inputmode="decimal" class="form-control text-end" @bind="amountText" />
        </div>
    </Body>
</ConfirmDialog>

@code {
    private ConfirmDialog dialog = default!;
    private string fundId = "";
    private string departmentId = "";
    private string accountId = "";
    private string amountText = "0.00";
    private Result? result;

    [Parameter, EditorRequired]
    public BudgetWorkspaceDto Workspace { get; set; } = default!;

    /// <summary>Receives the request; the page calls the service and reloads. Returns the service result for display.</summary>
    [Parameter]
    public Func<AddBudgetLineRequest, Task<Result>> OnAdd { get; set; } = default!;

    public void Show()
    {
        result = null;
        dialog.Show();
    }

    private async Task<bool> SubmitAsync()
    {
        if (!Guid.TryParse(fundId, out Guid fund) || !Guid.TryParse(accountId, out Guid account))
        {
            result = Result.Failure("Choose a fund and an account.");
            return false;
        }

        if (!decimal.TryParse(amountText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.GetCultureInfo("en-US"), out decimal amount))
        {
            result = Result.Failure("Enter a valid amount.");
            return false;
        }

        Guid? department = Guid.TryParse(departmentId, out Guid d) ? d : null;
        result = await OnAdd(new AddBudgetLineRequest(Workspace.Version.Id, fund, department, account, amount, 0m, 0m, null));
        if (result.IsFailure)
        {
            return false; // keep the dialog open with the message
        }

        accountId = "";
        amountText = "0.00";
        return true;
    }
}
