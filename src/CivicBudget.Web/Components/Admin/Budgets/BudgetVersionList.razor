@page "/admin/budgets"
@attribute [Authorize(Policy = Policies.CanViewBudget)]
@using CivicBudget.Application.Publishing
@inject IBudgetEntryService BudgetEntry
@inject IPublishingService Publishing

<PageTitle>Budget versions</PageTitle>

<PageHeader Title="Budget versions" Eyebrow="Budget" Crumbs="@([new Crumb("Budget"), new Crumb("Budget versions")])" Tip="Each fiscal year has an original budget and, after adoption, any amendments. Open a version to enter or review its lines.">
    <Actions>
        @* A new year's budget is started from its fiscal year, which is where "empty or from last year" is chosen. *@
        <AuthorizeView Policy="@Policies.CanMaintainSetup">
            <a class="btn btn-outline-primary btn-sm" href="admin/fiscal-years"><i class="bi bi-plus-square me-1" aria-hidden="true"></i>Start a new year's budget</a>
        </AuthorizeView>
    </Actions>
    </PageHeader>

@if (versions is null)
{
    <SkeletonRows Rows="5" Columns="6" />
}
else
{
    <div class="card mb-4">
        <div class="cb-cards d-md-none">
            @foreach (BudgetVersionSummaryDto version in versions)
            {
                <ListCard Title="@($"FY{version.Year} {version.Label}")" Summary="@VersionSummary(version)" Href="@($"admin/budgets/{version.Id}")">
                    <Aside><StatusPill Budget="version.Status" />@PortalPill(version)</Aside>
                    <Menu><a class="btn btn-sm btn-outline-primary" href="admin/budgets/@version.Id">@(version.Status == BudgetStatus.Adopted ? "Open" : "Continue")</a></Menu>
                </ListCard>
            }
        </div>
        <div class="cb-grid-wrap d-none d-md-block">
            <table class="cb-grid">
                <thead>
                    <tr>
                        <th>Fiscal year</th>
                        <th>Version</th>
                        <th>Status</th>
                        <th>Resolution</th>
                        <th>Portal</th>
                        <th class="cb-num">Lines</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BudgetVersionSummaryDto version in versions)
                    {
                        <tr>
                            <td>FY@(version.Year)</td>
                            <td class="cb-wrap">
                                @version.Label
                                @if (version.AmendmentReason is not null)
                                {
                                    <div class="small text-secondary">@version.AmendmentReason</div>
                                }
                            </td>
                            <td><StatusPill Budget="version.Status" /></td>
                            <td class="cb-code">@version.ResolutionNumber</td>
                            <td>@PortalPill(version)</td>
                            <td class="cb-num">@version.LineCount</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="admin/budgets/@version.Id">@(version.Status == BudgetStatus.Adopted ? "Open" : "Continue")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="h6 fw-semibold" id="publishing">Publishing history</h2>
    @if (snapshots is { Count: > 0 })
    {
        <div class="card">
            <div class="cb-cards d-md-none">
                @foreach (SnapshotSummaryDto snapshot in snapshots)
                {
                    <ListCard Title="@($"FY{snapshot.FiscalYear} {snapshot.VersionLabel}")" Summary="@SnapshotSummary(snapshot)" Aside="@SnapshotPill(snapshot)" />
                }
            </div>
            <div class="cb-grid-wrap d-none d-md-block">
                <table class="cb-grid">
                    <thead>
                        <tr><th>Fiscal year</th><th>Version</th><th>Published</th><th>By</th><th>Status</th><th class="cb-num">Lines</th></tr>
                    </thead>
                    <tbody>
                        @foreach (SnapshotSummaryDto snapshot in snapshots)
                        {
                            <tr>
                                <td>FY@(snapshot.FiscalYear)</td>
                                <td>@snapshot.VersionLabel</td>
                                <td>@Display.Timestamp(snapshot.PublishedAtUtc)</td>
                                <td>@snapshot.PublishedByUserName</td>
                                <td>@SnapshotPill(snapshot)</td>
                                <td class="cb-num">@snapshot.LineCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card"><EmptyState Icon="bi-megaphone" Title="Nothing published yet" Text="Adopt a budget, then publish it from its workspace." /></div>
    }
}

@code {
    private IReadOnlyList<BudgetVersionSummaryDto>? versions;
    private IReadOnlyList<SnapshotSummaryDto>? snapshots;

    protected override async Task OnInitializedAsync()
    {
        versions = await BudgetEntry.ListVersionsAsync();
        snapshots = await Publishing.ListAsync();
    }

    // Shared between the table cells and the phone cards.
    private static RenderFragment VersionSummary(BudgetVersionSummaryDto version) => @<text>@version.LineCount lines@(version.ResolutionNumber is null ? "" : $" · resolution {version.ResolutionNumber}")@(version.AmendmentReason is null ? "" : $" · {version.AmendmentReason}")</text>;

    private RenderFragment? PortalPill(BudgetVersionSummaryDto version)
    {
        if (snapshots?.FirstOrDefault(s => s.BudgetVersionId == version.Id && s.Status == Domain.Publishing.SnapshotStatus.Active) is { } active)
        {
            return @<StatusPill Tone="success" Label="@($"Published {Display.ShortDate(active.PublishedAtUtc)}")" />;
        }

        return snapshots?.Any(s => s.BudgetVersionId == version.Id) == true ? @<span class="cb-code">Previously published</span> : null;
    }

    private static RenderFragment SnapshotSummary(SnapshotSummaryDto snapshot) => @<text>Published @Display.Timestamp(snapshot.PublishedAtUtc) by @snapshot.PublishedByUserName · @snapshot.LineCount lines</text>;

    private static RenderFragment SnapshotPill(SnapshotSummaryDto snapshot) =>
        @<StatusPill Snapshot="snapshot.Status" Label="@(snapshot.Status == Domain.Publishing.SnapshotStatus.Active ? "Active" : $"{snapshot.Status} {snapshot.StatusChangedAtUtc:MMM d, yyyy}")" />;
}
