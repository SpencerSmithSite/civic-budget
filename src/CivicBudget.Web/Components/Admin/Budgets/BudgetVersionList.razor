@page "/admin/budgets"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.CanViewBudget)]
@using CivicBudget.Application.Publishing
@inject IBudgetEntryService BudgetEntry
@inject IPublishingService Publishing

<PageTitle>Budget versions</PageTitle>

<PageHeader Title="Budget versions" Eyebrow="Budget" Crumbs="@([new Crumb("Budget"), new Crumb("Budget versions")])" Tip="Each fiscal year has an original budget and, after adoption, any amendments. Open a version to enter or review its lines.">
    </PageHeader>

@if (versions is null)
{
    <SkeletonRows Rows="5" Columns="6" />
}
else
{
    <div class="card mb-4">
        <div class="cb-grid-wrap">
            <table class="cb-grid">
                <thead>
                    <tr>
                        <th>Fiscal year</th>
                        <th>Version</th>
                        <th>Status</th>
                        <th>Resolution</th>
                        <th>Portal</th>
                        <th class="cb-num">Lines</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BudgetVersionSummaryDto version in versions)
                    {
                        <tr>
                            <td>FY@(version.Year)</td>
                            <td class="cb-wrap">
                                @version.Label
                                @if (version.AmendmentReason is not null)
                                {
                                    <div class="small text-secondary">@version.AmendmentReason</div>
                                }
                            </td>
                            <td><StatusPill Budget="version.Status" /></td>
                            <td class="cb-code">@version.ResolutionNumber</td>
                            <td>
                                @if (snapshots?.FirstOrDefault(s => s.BudgetVersionId == version.Id && s.Status == Domain.Publishing.SnapshotStatus.Active) is { } active)
                                {
                                    <StatusPill Tone="success" Label="@($"Published {active.PublishedAtUtc:MMM d, yyyy}")" />
                                }
                                else if (snapshots?.Any(s => s.BudgetVersionId == version.Id) == true)
                                {
                                    <span class="cb-code">Previously published</span>
                                }
                            </td>
                            <td class="cb-num">@version.LineCount</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="admin/budgets/@version.Id">@(version.Status == BudgetStatus.Adopted ? "Open" : "Continue")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="h6 fw-semibold" id="publishing">Publishing history</h2>
    @if (snapshots is { Count: > 0 })
    {
        <div class="card">
            <div class="cb-grid-wrap">
                <table class="cb-grid">
                    <thead>
                        <tr><th>Fiscal year</th><th>Version</th><th>Published</th><th>By</th><th>Status</th><th class="cb-num">Lines</th></tr>
                    </thead>
                    <tbody>
                        @foreach (SnapshotSummaryDto snapshot in snapshots)
                        {
                            <tr>
                                <td>FY@(snapshot.FiscalYear)</td>
                                <td>@snapshot.VersionLabel</td>
                                <td>@snapshot.PublishedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</td>
                                <td>@snapshot.PublishedByUserName</td>
                                <td>
                                    <StatusPill Snapshot="snapshot.Status" Label="@(snapshot.Status == Domain.Publishing.SnapshotStatus.Active ? "Active" : $"{snapshot.Status} {snapshot.StatusChangedAtUtc:MMM d, yyyy}")" />
                                </td>
                                <td class="cb-num">@snapshot.LineCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card"><EmptyState Icon="bi-megaphone" Title="Nothing published yet" Text="Adopt a budget, then publish it from its workspace." /></div>
    }
}

@code {
    private IReadOnlyList<BudgetVersionSummaryDto>? versions;
    private IReadOnlyList<SnapshotSummaryDto>? snapshots;

    protected override async Task OnInitializedAsync()
    {
        versions = await BudgetEntry.ListVersionsAsync();
        snapshots = await Publishing.ListAsync();
    }
}
