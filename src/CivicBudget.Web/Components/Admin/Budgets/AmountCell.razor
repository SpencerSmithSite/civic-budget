@* One money value. Read-only lines print it; editable lines render an input, outlined so it reads
   as a field (the outline is what tells the two apart at a glance), that saves on change. Typing is local: nothing crosses the circuit
   until the field loses focus or Enter is pressed. While the save round-trip runs the value shows
   in "unsaved" blue (a convention from planning tools like Adaptive). A value that is not an amount
   is refused out loud: the field is marked invalid and a toast (an alert) says what to type. *@
@inject ToastService Toasts
@if (CanEdit && Positions is null)
{
    <input @key="resetKey" type="text" inputmode="decimal"
           class="cb-amount-input @(invalid ? "is-invalid" : "") @(saving ? "cb-saving" : "")"
           value="@Value.ToString("N2", Culture)"
           aria-label="@Label"
           aria-invalid="@(invalid ? "true" : null)"
           @onchange="OnChangedAsync" />
}
else if (Positions is { } positions)
{
    @* Calculated from the department's positions: read-only here, changed on the personnel page. *@
    <span class="cb-num d-block">@Display.Money(Value)</span>
    <a class="cb-from-positions" href="@PositionsHref" title="Calculated from positions; change them on the personnel page">
        <i class="bi bi-people me-1" aria-hidden="true"></i>from @positions position@(positions == 1 ? "" : "s")
    </a>
}
else
{
    <span class="cb-num d-block">@Display.Money(Value)</span>
}

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    private bool invalid;
    private bool saving;

    // Blazor diffs against what it rendered last, not what is in the browser. When a save is refused
    // (or the text was just a reformatting of the same amount), Value does not change, so no update
    // is sent and the input keeps the typed text while the totals around it show the saved amount.
    // A new key renders a fresh input that shows Value.
    private int resetKey;

    [Parameter, EditorRequired]
    public decimal Value { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public string Label { get; set; } = "Amount";

    /// <summary>Set when the amount is calculated from positions: it then shows read-only with a link to them.</summary>
    [Parameter]
    public int? Positions { get; set; }

    [Parameter]
    public string? PositionsHref { get; set; }

    [Parameter]
    public EventCallback<decimal> ValueChanged { get; set; }

    private async Task OnChangedAsync(ChangeEventArgs e)
    {
        string text = (e.Value?.ToString() ?? "").Replace("$", "", StringComparison.Ordinal).Trim();
        if (!decimal.TryParse(text, System.Globalization.NumberStyles.Number, Culture, out decimal parsed) || parsed < 0 || !CivicBudget.Domain.Common.Money.IsStorable(parsed))
        {
            invalid = true;
            Toasts.Danger($"Not saved: {Label} must be an amount of zero or more, such as 1,250.00.");
            return;
        }

        invalid = false;
        if (parsed == Value)
        {
            resetKey++;
            return;
        }

        saving = true;
        try
        {
            await ValueChanged.InvokeAsync(parsed);
        }
        finally
        {
            saving = false;
            if (Value != parsed)
            {
                resetKey++;
            }
        }
    }
}
