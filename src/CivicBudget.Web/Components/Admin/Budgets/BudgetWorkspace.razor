@page "/admin/budgets/{VersionId:guid}"
@attribute [Authorize(Policy = Policies.CanViewBudget)]
@using CivicBudget.Application.Publishing
@inject IBudgetEntryService BudgetEntry
@inject IBudgetWorkflowService Workflow
@inject IPublishingService Publishing
@inject ToastService Toasts

<PageTitle>@(workspace is null ? "Budget" : $"FY{workspace.Version.Year} {workspace.Version.Label}")</PageTitle>

@if (notFound)
{
    <EmptyState Icon="bi-journal-x" Title="Budget version not found" Text="It may have been removed, or the link is wrong."><a class="btn btn-primary" href="admin/budgets">Budget versions</a></EmptyState>
}
else if (workspace is null || workflowState is null)
{
    <PageHeader Title="Loading budget" Eyebrow="Budget" Crumbs="@([new Crumb("Budget"), new Crumb("Budget versions", "admin/budgets"), new Crumb("…")])" />
    <SkeletonRows Rows="8" Columns="6" />
}
else
{
    <PageHeader Title="@($"{workspace.Version.Label} budget")" Eyebrow="@($"Budget · Fiscal year {workspace.Version.Year}")"
                Crumbs="@([new Crumb("Budget"), new Crumb("Budget versions", "admin/budgets"), new Crumb($"FY{workspace.Version.Year} {workspace.Version.Label}")])"
                Tip="@(workspace.IsEditable ? "Edit amounts in place; a change saves when you leave the field. Fund balances on the right update as you go." : "Adopted versions are read-only. Start an amendment to change them.")">
        <TitleAddon><StatusPill Budget="workspace.Version.Status" /></TitleAddon>
        <Subtitle>@workspace.Version.AmendmentReason</Subtitle>
        <Actions>
            @if (!isDepartmentHead)
            {
                <div class="btn-group btn-group-sm" role="group" aria-label="Entry mode">
                    <button type="button" class="btn @(mode == Mode.ByDepartment ? "btn-primary" : "btn-outline-primary")" @onclick="() => mode = Mode.ByDepartment">By department</button>
                    <button type="button" class="btn @(mode == Mode.ByAccount ? "btn-primary" : "btn-outline-primary")" @onclick="() => mode = Mode.ByAccount">By account line</button>
                </div>
            }
            <div class="dropdown">
                <button type="button" class="btn btn-outline-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-tools me-1" aria-hidden="true"></i>Tools</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="admin/export/budgets/@VersionId/lines.xlsx"><i class="bi bi-file-earmark-spreadsheet me-2" aria-hidden="true"></i>Export lines (XLSX)</a></li>
                    <li><a class="dropdown-item" href="admin/reports/@VersionId/fund-summary"><i class="bi bi-file-earmark-bar-graph me-2" aria-hidden="true"></i>Reports for this version</a></li>
                    <AuthorizeView Policy="@Policies.CanImport">
                        @if (workspace.IsEditable)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="admin/budgets/@VersionId/import"><i class="bi bi-upload me-2" aria-hidden="true"></i>Import lines from a file</a></li>
                        }
                    </AuthorizeView>
                </ul>
            </div>
            <WorkflowBar Version="workspace.Version" State="workflowState" ActiveSnapshot="activeSnapshot" OnChanged="LoadAsync" />
        </Actions>
    </PageHeader>

    <WorkflowStepper Status="workspace.Version.Status" IsPublished="activeSnapshot is not null" />

    <div class="cb-workspace">
        <div>
            @if (mode == Mode.ByDepartment)
            {
                <DepartmentEntryView Lines="workspace.Lines" FiscalYear="workspace.Version.Year" OnAmountChanged="UpdateAmountAsync" OnShowHistory="ShowHistory" />
                @if (workspace.CanAddLines)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => addLineForm.Show()"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add line</button>
                }
            }
            else
            {
                <div class="card">
                    <AccountLineGrid Workspace="workspace" OnAmountChanged="UpdateAmountAsync" OnJustificationChanged="UpdateJustificationAsync"
                                     OnShowHistory="ShowHistory" OnRemove="RemoveLineAsync" OnAddLine="() => addLineForm.Show()" />
                </div>
            }
        </div>
        <aside>
            <FundBalancePanel Balances="workspace.FundBalances" OnBeginningBalanceChanged="SetBeginningBalanceAsync" />
        </aside>
    </div>

    <AddLineForm @ref="addLineForm" Workspace="workspace" OnAdd="AddLineAsync" />

    <ConfirmDialog @ref="removeDialog" Title="Remove this line?" ConfirmText="Remove line" ConfirmClass="btn-danger" OnConfirm="ConfirmRemoveAsync">
        <Body>
            @if (lineToRemove is not null)
            {
                <p><b>@lineToRemove.AccountCode @lineToRemove.AccountName</b> in @lineToRemove.FundCode @lineToRemove.FundName@(lineToRemove.DepartmentCode is null ? "" : $", {lineToRemove.DepartmentCode}") will be removed from this version. The audit trail keeps a record.</p>
            }
        </Body>
    </ConfirmDialog>

    <SideDrawer IsOpen="historyLine is not null" IsOpenChanged="open => { if (!open) historyLine = null; }" Title="@(historyLine is null ? "" : $"History: {historyLine.AccountCode} {historyLine.AccountName}")">
        @if (historyLine is not null)
        {
            <div class="px-3 pt-2 small text-secondary">@historyLine.FundCode @historyLine.FundName@(historyLine.DepartmentCode is null ? "" : $" · {historyLine.DepartmentCode} {historyLine.DepartmentName}")</div>
            <LineHistory Line="historyLine" Version="historyVersion" />
        }
    </SideDrawer>
}

@code {
    private enum Mode { ByDepartment, ByAccount }

    [Parameter]
    public Guid VersionId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private BudgetWorkspaceDto? workspace;
    private WorkflowStateDto? workflowState;
    private SnapshotSummaryDto? activeSnapshot;
    private Mode mode = Mode.ByDepartment;
    private bool notFound;
    private bool isDepartmentHead;
    private BudgetLineDto? historyLine;
    private int historyVersion;
    private AddLineForm addLineForm = default!;
    private ConfirmDialog removeDialog = default!;
    private BudgetLineDto? lineToRemove;

    protected override async Task OnInitializedAsync()
    {
        // Finance Directors (and admins/viewers) default to the grid; Department Heads only have the grouped view.
        AuthenticationState state = await AuthenticationState;
        isDepartmentHead = state.User.IsInRole(Roles.DepartmentHead);
        if (!isDepartmentHead)
        {
            mode = Mode.ByAccount;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        workspace = await BudgetEntry.GetWorkspaceAsync(VersionId);
        notFound = workspace is null;
        workflowState = notFound ? null : await Workflow.GetStateAsync(VersionId);
        activeSnapshot = notFound ? null : (await Publishing.ListAsync())
            .FirstOrDefault(s => s.BudgetVersionId == VersionId && s.Status == Domain.Publishing.SnapshotStatus.Active);
        if (historyLine is not null && workspace is not null)
        {
            historyLine = workspace.Lines.FirstOrDefault(l => l.Id == historyLine.Id);
            historyVersion++;
        }
    }

    // Every mutation goes through the service and then reloads the workspace, so the fund balance
    // panel and subtotals are always computed from saved data rather than from screen state.
    private Task UpdateAmountAsync((Guid LineId, decimal Amount) change) =>
        ApplyAsync(() => BudgetEntry.UpdateLineAmountAsync(VersionId, change.LineId, change.Amount), "Amount saved.");

    private Task UpdateJustificationAsync((Guid LineId, string? Justification) change) =>
        ApplyAsync(() => BudgetEntry.UpdateLineJustificationAsync(VersionId, change.LineId, change.Justification), "Note saved.");

    private Task SetBeginningBalanceAsync((Guid FundId, decimal Amount) change) =>
        ApplyAsync(() => BudgetEntry.SetBeginningBalanceAsync(VersionId, change.FundId, change.Amount), "Beginning balance saved.");

    private async Task<Result> AddLineAsync(AddBudgetLineRequest request)
    {
        Result<Guid> added = await BudgetEntry.AddLineAsync(request);
        if (added.IsSuccess)
        {
            Toasts.Success("Line added.");
            await LoadAsync();
        }

        return added;
    }

    private void RemoveLineAsync(BudgetLineDto line)
    {
        lineToRemove = line;
        removeDialog.Show();
    }

    private async Task<bool> ConfirmRemoveAsync()
    {
        if (lineToRemove is not null)
        {
            await ApplyAsync(() => BudgetEntry.RemoveLineAsync(VersionId, lineToRemove.Id), "Line removed.");
        }

        return true;
    }

    private async Task ApplyAsync(Func<Task<Result>> action, string successMessage)
    {
        Result result = await action();
        if (result.IsSuccess)
        {
            Toasts.Success(successMessage);
        }
        else
        {
            Toasts.Danger(result.Errors[0].Message);
        }

        await LoadAsync();
    }

    private void ShowHistory(BudgetLineDto line)
    {
        historyLine = line;
        historyVersion++;
    }
}
