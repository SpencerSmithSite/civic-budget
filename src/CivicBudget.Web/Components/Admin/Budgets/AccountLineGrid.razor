@using CivicBudget.Domain.Accounts
@* By-account-line mode: the whole version in one sortable, filterable worksheet with inline
   editing. Group rows per fund and department come from the sorted order, so the grid reads like a
   printed budget without a tree control. *@

<div class="cb-toolbar">
    <input class="form-control" placeholder="Search number, account, or department" @bind="search" @bind:event="oninput" aria-label="Search lines" />
    <select class="form-select" @bind="fundFilter" aria-label="Filter by fund">
        <option value="">All funds</option>
        @foreach (LookupDto fund in Workspace.Funds)
        {
            <option value="@fund.Id">@fund.Display</option>
        }
    </select>
    <select class="form-select" @bind="departmentFilter" aria-label="Filter by department">
        <option value="">All @Workspace.NumberFormat.DepartmentLabel.ToLowerInvariant()s</option>
        <option value="none">Fund level (no @Workspace.NumberFormat.DepartmentLabel.ToLowerInvariant())</option>
        @foreach (LookupDto department in Workspace.Departments)
        {
            <option value="@department.Id">@department.Display</option>
        }
    </select>
    <select class="form-select" @bind="typeFilter" aria-label="Filter by account type">
        <option value="">All types</option>
        @foreach (AccountType type in Enum.GetValues<AccountType>())
        {
            <option value="@type">@Display.Enum(type)</option>
        }
    </select>
    <span class="grow"></span>
    @if (Workspace.CanAddLines)
    {
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OnAddLine.InvokeAsync()"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add line</button>
    }
    <a class="btn btn-outline-primary btn-sm" href="admin/export/budgets/@Workspace.Version.Id/lines.xlsx"><i class="bi bi-download me-1" aria-hidden="true"></i>Export</a>
</div>

<div class="cb-grid-wrap">
    <table class="cb-grid">
        <thead>
            <tr>
                <th>Account</th>
                <th class="cb-num">@PriorLabel actual</th>
                <th class="cb-num">@CurrentLabel budget</th>
                <th class="cb-num">@ProposedLabel proposed</th>
                <th class="cb-num">Change $</th>
                <th class="cb-num">Change %</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @{ string? lastGroup = null; }
            @foreach (BudgetLineDto line in Filtered)
            {
                string group = $"{line.FundCode} {line.FundName} · {(line.DepartmentCode is null ? (line.AccountType.IsResource() ? "Revenues and transfers in" : "Fund level") : $"{line.DepartmentCode} {line.DepartmentName}")}";
                if (group != lastGroup)
                {
                    lastGroup = group;
                    <tr class="cb-group"><td colspan="7">@group</td></tr>
                }
                <tr>
                    <td class="cb-wrap" title="@Display.Enum(line.Category)">
                        <span class="cb-code">@line.AccountNumber</span> @line.AccountName
                        @if (editingNoteId == line.Id)
                        {
                            <input type="text" class="form-control form-control-sm mt-1" value="@line.Justification" aria-label="@($"Justification for {line.AccountCode}")"
                                   @onchange="e => SaveNoteAsync(line.Id, e.Value?.ToString())" @onblur="() => editingNoteId = null" autofocus />
                        }
                        else if (!string.IsNullOrEmpty(line.Justification))
                        {
                            <div class="small text-secondary fst-italic text-wrap"><i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>@line.Justification</div>
                        }
                    </td>
                    <td class="cb-num">@line.PriorYearActual.ToString("N2")</td>
                    <td class="cb-num">@line.CurrentYearBudget.ToString("N2")</td>
                    <td class="cb-num">
                        <AmountCell Value="line.Amount" CanEdit="line.CanEdit" Label="@($"Proposed amount for {line.AccountCode} {line.AccountName}, {line.DepartmentCode ?? line.FundCode}")"
                                    ValueChanged="amount => OnAmountChanged.InvokeAsync((line.Id, amount))" />
                    </td>
                    <td class="cb-num @(line.DollarChange < 0 ? "cb-neg" : line.DollarChange > 0 ? "cb-pos" : "")">@Display.SignedChange(line.DollarChange)</td>
                    <td class="cb-num @(line.PercentChange < 0 ? "cb-neg" : "")">@Display.Percent(line.PercentChange)</td>
                    <td class="text-end">
                        <RowMenu Label="@($"Actions for {line.AccountCode}")">
                            <li><button type="button" class="dropdown-item" @onclick="() => OnShowHistory.InvokeAsync(line)"><i class="bi bi-clock-history me-2" aria-hidden="true"></i>History</button></li>
                            @if (line.CanEdit)
                            {
                                <li><button type="button" class="dropdown-item" @onclick="() => editingNoteId = line.Id"><i class="bi bi-chat-left-text me-2" aria-hidden="true"></i>@(string.IsNullOrEmpty(line.Justification) ? "Add note" : "Edit note")</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button type="button" class="dropdown-item text-danger" @onclick="() => OnRemove.InvokeAsync(line)"><i class="bi bi-trash me-2" aria-hidden="true"></i>Remove line</button></li>
                            }
                        </RowMenu>
                    </td>
                </tr>
            }
            @if (!Filtered.Any())
            {
                <tr><td colspan="7"><EmptyState Icon="bi-funnel" Title="No lines match" Text="Clear a filter or the search box to see more." /></td></tr>
            }
        </tbody>
    </table>
</div>
<div class="cb-grid-foot">
    <span>@Filtered.Count() of @Workspace.Lines.Count lines</span>
</div>

@code {
    private string search = "";
    private string fundFilter = "";
    private string departmentFilter = "";
    private string typeFilter = "";
    private Guid? editingNoteId;

    [Parameter, EditorRequired]
    public BudgetWorkspaceDto Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback<(Guid LineId, decimal Amount)> OnAmountChanged { get; set; }

    [Parameter]
    public EventCallback<(Guid LineId, string? Justification)> OnJustificationChanged { get; set; }

    [Parameter]
    public EventCallback<BudgetLineDto> OnShowHistory { get; set; }

    [Parameter]
    public EventCallback<BudgetLineDto> OnRemove { get; set; }

    [Parameter]
    public EventCallback OnAddLine { get; set; }

    private string PriorLabel => $"FY{Workspace.Version.Year - 2}";
    private string CurrentLabel => $"FY{Workspace.Version.Year - 1}";
    private string ProposedLabel => $"FY{Workspace.Version.Year}";

    private async Task SaveNoteAsync(Guid lineId, string? note)
    {
        editingNoteId = null;
        await OnJustificationChanged.InvokeAsync((lineId, note));
    }

    /// <summary>"1000-110", "1000.110", "1000 110", or "1000110" all find the same lines; separators are ignored on both sides.</summary>
    private static bool MatchesNumber(string number, string search)
    {
        string compact = search.Replace("-", "").Replace(".", "").Replace(" ", "");
        return compact.Length >= 3 && number.Replace("-", "").Replace(".", "").Contains(compact, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<BudgetLineDto> Filtered => Workspace.Lines
        .Where(l => string.IsNullOrWhiteSpace(search)
            || l.AccountCode.Contains(search, StringComparison.OrdinalIgnoreCase)
            || MatchesNumber(l.AccountNumber, search)
            || l.AccountName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (l.DepartmentName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(l => string.IsNullOrEmpty(fundFilter) || l.FundId.ToString() == fundFilter)
        .Where(l => string.IsNullOrEmpty(departmentFilter)
            || (departmentFilter == "none" ? l.DepartmentId is null : l.DepartmentId?.ToString() == departmentFilter))
        .Where(l => string.IsNullOrEmpty(typeFilter) || l.AccountType.ToString() == typeFilter)
        .OrderBy(l => l.FundCode).ThenBy(l => l.DepartmentCode is null ? 0 : 1).ThenBy(l => l.DepartmentCode).ThenBy(l => l.AccountCode);
}
