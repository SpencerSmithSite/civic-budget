@using CivicBudget.Domain.Accounts
@* By-account-line mode: every line in the version in one sortable, filterable grid with inline editing. *@

<div class="row g-2 mb-2">
    <div class="col-md-3">
        <input class="form-control form-control-sm" placeholder="Search account or department" @bind="search" @bind:event="oninput" aria-label="Search lines" />
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="fundFilter" aria-label="Filter by fund">
            <option value="">All funds</option>
            @foreach (LookupDto fund in Workspace.Funds)
            {
                <option value="@fund.Id">@fund.Display</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="departmentFilter" aria-label="Filter by department">
            <option value="">All departments</option>
            <option value="none">(Fund level, no department)</option>
            @foreach (LookupDto department in Workspace.Departments)
            {
                <option value="@department.Id">@department.Display</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="typeFilter" aria-label="Filter by account type">
            <option value="">All account types</option>
            @foreach (AccountType type in Enum.GetValues<AccountType>())
            {
                <option value="@type">@Display.Enum(type)</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
@* Theme="bootstrap" (any name but "default") switches off QuickGrid's built-in cell styling so
   Bootstrap's .table classes and app.css control the dense layout. *@
<QuickGrid Items="Filtered" Theme="bootstrap" Class="table table-sm table-striped align-middle budget-lines" Pagination="pagination">
    <TemplateColumn Title="Fund" Class="col-code" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.FundCode)">
        <span title="@context.FundName">@context.FundCode</span>
    </TemplateColumn>
    <TemplateColumn Title="Dept" Class="col-code" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.DepartmentCode)">
        <span title="@context.DepartmentName">@(context.DepartmentCode ?? "")</span>
    </TemplateColumn>
    <TemplateColumn Title="Account" Class="col-account" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.AccountCode)">
        <span class="text-secondary">@context.AccountCode</span> @context.AccountName
        <span class="small text-secondary">(@Display.Enum(context.Category))</span>
    </TemplateColumn>
    <TemplateColumn Title="Prior actual" Class="col-money" Align="Align.End" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.PriorYearActual)">
        @Display.Money(context.PriorYearActual)
    </TemplateColumn>
    <TemplateColumn Title="Current" Class="col-money" Align="Align.End" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.CurrentYearBudget)">
        @Display.Money(context.CurrentYearBudget)
    </TemplateColumn>
    <TemplateColumn Title="Proposed" Class="col-amount" Align="Align.End" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.Amount)">
        <AmountCell Value="context.Amount" CanEdit="context.CanEdit" Label="@($"Proposed amount for {context.AccountCode}")"
                    ValueChanged="amount => OnAmountChanged.InvokeAsync((context.Id, amount))" />
    </TemplateColumn>
    <TemplateColumn Title="$ change" Align="Align.End" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.DollarChange)">
        @Display.SignedMoney(context.DollarChange)
    </TemplateColumn>
    <TemplateColumn Title="% change" Align="Align.End" SortBy="GridSort<BudgetLineDto>.ByAscending(l => l.PercentChange ?? decimal.MaxValue)">
        @Display.Percent(context.PercentChange)
    </TemplateColumn>
    <TemplateColumn Title="Note" Class="col-note">
        @* A note is rare, so the column stays narrow: a marker, and an editor only for the row being edited. *@
        @if (editingNoteId == context.Id)
        {
            <input type="text" class="form-control form-control-sm" value="@context.Justification" aria-label="@($"Justification for {context.AccountCode}")"
                   @onchange="e => SaveNoteAsync(context.Id, e.Value?.ToString())" @onblur="() => editingNoteId = null" autofocus />
        }
        else
        {
            <button type="button" class="btn btn-link btn-sm p-0" title="@context.Justification"
                    @onclick="() => editingNoteId = context.CanEdit ? context.Id : null">
                @(string.IsNullOrEmpty(context.Justification) ? (context.CanEdit ? "Add" : "") : "Note")
            </button>
        }
    </TemplateColumn>
    <TemplateColumn Title="" Align="Align.End">
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => OnShowHistory.InvokeAsync(context)">History</button>
        @if (context.CanEdit)
        {
            <button type="button" class="btn btn-link btn-sm p-0 ms-2 text-danger" @onclick="() => OnRemove.InvokeAsync(context)">Remove</button>
        }
    </TemplateColumn>
</QuickGrid>
</div>
<Paginator State="pagination" />

@code {
    private string search = "";
    private string fundFilter = "";
    private string departmentFilter = "";
    private string typeFilter = "";
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
    private Guid? editingNoteId;

    [Parameter, EditorRequired]
    public BudgetWorkspaceDto Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback<(Guid LineId, decimal Amount)> OnAmountChanged { get; set; }

    [Parameter]
    public EventCallback<(Guid LineId, string? Justification)> OnJustificationChanged { get; set; }

    [Parameter]
    public EventCallback<BudgetLineDto> OnShowHistory { get; set; }

    [Parameter]
    public EventCallback<BudgetLineDto> OnRemove { get; set; }

    private async Task SaveNoteAsync(Guid lineId, string? note)
    {
        editingNoteId = null;
        await OnJustificationChanged.InvokeAsync((lineId, note));
    }

    private IQueryable<BudgetLineDto> Filtered => Workspace.Lines
        .Where(l => string.IsNullOrWhiteSpace(search)
            || l.AccountCode.Contains(search, StringComparison.OrdinalIgnoreCase)
            || l.AccountName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (l.DepartmentName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(l => string.IsNullOrEmpty(fundFilter) || l.FundId.ToString() == fundFilter)
        .Where(l => string.IsNullOrEmpty(departmentFilter)
            || (departmentFilter == "none" ? l.DepartmentId is null : l.DepartmentId?.ToString() == departmentFilter))
        .Where(l => string.IsNullOrEmpty(typeFilter) || l.AccountType.ToString() == typeFilter)
        .AsQueryable();
}
