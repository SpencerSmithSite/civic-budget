@* Per-fund cards: the projected ending balance is the number that matters, so it is the big one;
   resources and appropriations sit under it. The colored rule and pill carry the limit result. *@
<div class="cb-fund-rail">
    <div class="cb-eyebrow mb-2 d-flex align-items-center">
        <span>Fund balances · projected ending</span>
        <span class="ms-auto">
            @if (Balances.Any(b => b.Limit.BlocksWorkflow))
            {
                <StatusPill Tone="danger" Label="Over limit" />
            }
            else if (Balances.Any(b => b.Limit.Severity == AppropriationLimitSeverity.Warning))
            {
                <StatusPill Tone="warning" Label="Warning" />
            }
            else
            {
                <StatusPill Tone="success" Label="In balance" />
            }
        </span>
    </div>
    @foreach (FundBalanceDto fund in Balances)
    {
        string tone = fund.Limit.Severity switch
        {
            AppropriationLimitSeverity.Error => "bad",
            AppropriationLimitSeverity.Warning => "warn",
            _ => "",
        };
        <div class="card cb-fund @tone">
            <div class="name">@fund.FundCode <span>@fund.FundName</span></div>
            <div class="v">@Display.SignedOrPlain(fund.Summary.ProjectedEndingBalance)</div>
            <div class="rows">
                <span>Beginning balance</span>
                <span>
                    <AmountCell Value="fund.Summary.BeginningBalance" CanEdit="fund.CanEditBeginningBalance"
                                Label="@($"Beginning balance for {fund.FundCode}")"
                                ValueChanged="amount => OnBeginningBalanceChanged.InvokeAsync((fund.FundId, amount))" />
                </span>
                <span>Estimated resources</span><b>@Display.Money(fund.Summary.EstimatedResources)</b>
                <span>Appropriations</span><b>@Display.Money(fund.Summary.Appropriations)</b>
            </div>
            @if (!fund.Summary.IsWithinAppropriationLimit)
            {
                <div class="mt-2 small">
                    Over estimated resources by <strong>@Display.Money(fund.Limit.AmountOverLimit)</strong>@(fund.Limit.BlocksWorkflow ? "; blocks proposal and adoption." : ".")
                </div>
            }
        </div>
    }
    <div class="small text-secondary lh-sm">
        Estimated resources = beginning balance + revenues + transfers in. Appropriations = expenditures + transfers out. Ohio law caps appropriations at certified estimated resources.
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FundBalanceDto> Balances { get; set; } = [];

    [Parameter]
    public EventCallback<(Guid FundId, decimal Amount)> OnBeginningBalanceChanged { get; set; }
}
