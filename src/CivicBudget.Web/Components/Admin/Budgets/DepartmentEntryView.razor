@* By-department mode: department, fund, category with subtotals at each level. department users see
   only their departments here (the service already filtered); the Fiscal Officer sees all. *@
@if (groups.Count == 0)
{
    <EmptyState Icon="bi-diagram-3" Title="No department lines" Text="Lines budgeted at fund level (revenues and transfers) appear in the by-account-line view." />
}
else
{
    @foreach (LineGroup department in groups)
    {
        <section class="mb-4">
            <h2 class="h6 fw-semibold d-flex align-items-baseline gap-2 mb-2"><span>@department.Title</span><span class="cb-eyebrow ms-auto">Department total @Display.Money(department.Amount)</span></h2>
            @foreach (LineGroup fund in department.Children)
            {
                <div class="card mb-3">
                    <div class="cb-grid-wrap">
                        <table class="cb-grid">
                            <caption class="caption-top px-3 pt-2 pb-1 fw-semibold small">@fund.Title</caption>
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th class="cb-num cb-col-wide">@PriorLabel actual</th>
                                    <th class="cb-num">@CurrentLabel budget</th>
                                    <th class="cb-num">@ProposedLabel proposed</th>
                                    <th class="cb-num cb-col-wide">Change $</th>
                                    <th class="cb-num cb-col-wide">Change %</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (LineGroup category in fund.Children)
                                {
                                    <tr class="cb-group"><td colspan="7">@category.Title</td></tr>
                                    @foreach (BudgetLineDto line in category.Lines)
                                    {
                                        <tr>
                                            <td class="cb-wrap">
                                                <span class="cb-code">@line.AccountNumber</span> @line.AccountName
                                                @if (!string.IsNullOrEmpty(line.Justification))
                                                {
                                                    <div class="small text-secondary fst-italic"><i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>@line.Justification</div>
                                                }
                                            </td>
                                            <td class="cb-num cb-col-wide">@line.PriorYearActual.ToString("N2")</td>
                                            <td class="cb-num">@line.CurrentYearBudget.ToString("N2")</td>
                                            <td class="cb-num">
                                                <AmountCell Value="line.Amount" CanEdit="line.CanEdit" Label="@($"Proposed amount for {line.AccountCode} {line.AccountName}, {line.FundCode}")"
                                                            ValueChanged="amount => OnAmountChanged.InvokeAsync((line.Id, amount))" />
                                            </td>
                                            <td class="cb-num cb-col-wide @(line.DollarChange < 0 ? "cb-neg" : line.DollarChange > 0 ? "cb-pos" : "")">@Display.SignedChange(line.DollarChange)</td>
                                            <td class="cb-num cb-col-wide @(line.PercentChange < 0 ? "cb-neg" : "")">@Display.Percent(line.PercentChange)</td>
                                            <td class="text-end">
                                                <button type="button" class="cb-row-open" @onclick="() => OnShowHistory.InvokeAsync(line)" aria-label="@($"Details for {line.AccountNumber}")"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                                                <RowMenu Label="@($"Actions for {line.AccountCode}")">
                                                    <li><button type="button" class="dropdown-item" @onclick="() => OnShowHistory.InvokeAsync(line)"><i class="bi bi-clock-history me-2" aria-hidden="true"></i>History</button></li>
                                                </RowMenu>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="cb-subtotal">
                                        <td>Subtotal, @category.Title</td>
                                        <td class="cb-num cb-col-wide">@category.PriorYearActual.ToString("N2")</td>
                                        <td class="cb-num">@category.CurrentYearBudget.ToString("N2")</td>
                                        <td class="cb-num">@category.Amount.ToString("N2")</td>
                                        <td class="cb-num cb-col-wide">@Display.SignedChange(category.DollarChange)</td>
                                        <td class="cb-num cb-col-wide">@Display.Percent(category.PercentChange)</td>
                                        <td></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Total, @fund.Title</td>
                                    <td class="cb-num cb-col-wide">@fund.PriorYearActual.ToString("N2")</td>
                                    <td class="cb-num">@fund.CurrentYearBudget.ToString("N2")</td>
                                    <td class="cb-num">@fund.Amount.ToString("N2")</td>
                                    <td class="cb-num cb-col-wide">@Display.SignedChange(fund.DollarChange)</td>
                                    <td class="cb-num cb-col-wide">@Display.Percent(fund.PercentChange)</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
        </section>
    }
}

@code {
    private IReadOnlyList<LineGroup> groups = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<BudgetLineDto> Lines { get; set; } = [];

    [Parameter, EditorRequired]
    public int FiscalYear { get; set; }

    [Parameter]
    public EventCallback<(Guid LineId, decimal Amount)> OnAmountChanged { get; set; }

    [Parameter]
    public EventCallback<BudgetLineDto> OnShowHistory { get; set; }

    private string PriorLabel => $"FY{FiscalYear - 2}";
    private string CurrentLabel => $"FY{FiscalYear - 1}";
    private string ProposedLabel => $"FY{FiscalYear}";

    protected override void OnParametersSet() => groups = BudgetGrouping.ByDepartment(Lines);
}
