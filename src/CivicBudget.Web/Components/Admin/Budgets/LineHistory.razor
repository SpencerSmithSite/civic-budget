@inject IAuditQueryService AuditQuery
@* The audit trail for one budget line, newest first. Field-level rows come from the AuditInterceptor;
   "Created" is the line's birth. Values are shown as the interceptor stored them (invariant text). *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>History: @Line.AccountCode @Line.AccountName (@Line.FundCode@(Line.DepartmentCode is null ? "" : $", {Line.DepartmentCode}"))</span>
        <button type="button" class="btn-close" aria-label="Close history" @onclick="OnClose"></button>
    </div>
    @if (entries is null)
    {
        <div class="card-body">Loading...</div>
    }
    else if (entries.Count == 0)
    {
        <div class="card-body text-secondary">No history recorded for this line.</div>
    }
    else
    {
        <table class="table table-sm mb-0">
            <thead>
                <tr><th scope="col">When (UTC)</th><th scope="col">Who</th><th scope="col">What</th><th scope="col">From</th><th scope="col">To</th></tr>
            </thead>
            <tbody>
                @foreach (AuditEntryDto entry in entries)
                {
                    <tr>
                        <td class="text-nowrap">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@entry.UserName</td>
                        <td>@(entry.Kind == Domain.Auditing.AuditKind.FieldChanged ? entry.PropertyName : entry.Description ?? entry.Kind.ToString())</td>
                        <td>@entry.OldValue</td>
                        <td>@entry.NewValue</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<AuditEntryDto>? entries;
    private Guid loadedFor;

    [Parameter, EditorRequired]
    public BudgetLineDto Line { get; set; } = default!;

    /// <summary>Bump to force a reload after an edit to the same line.</summary>
    [Parameter]
    public int Version { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private int loadedVersion = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Line.Id && loadedVersion == Version)
        {
            return;
        }

        loadedFor = Line.Id;
        loadedVersion = Version;
        entries = null;
        entries = await AuditQuery.GetHistoryAsync(nameof(BudgetLine), Line.Id);
    }
}
