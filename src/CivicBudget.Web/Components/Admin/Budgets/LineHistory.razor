@inject IAuditQueryService AuditQuery
@* The audit trail for one budget line as a timeline, newest first. Field-level rows come from the
   AuditInterceptor; "Created" is the line's birth. *@
@if (entries is null)
{
    <SkeletonRows Rows="4" Columns="3" />
}
else if (entries.Count == 0)
{
    <EmptyState Icon="bi-clock-history" Title="No history yet" Text="Changes to this line will appear here with who made them and when." />
}
else
{
    <ul class="cb-timeline">
        @foreach (AuditEntryDto entry in entries)
        {
            <li>
                <Avatar UserId="@entry.UserId" Name="@entry.UserName" />
                <div>
                    <b>@entry.UserName</b>
                    @switch (entry.Kind)
                    {
                        case Domain.Auditing.AuditKind.FieldChanged:
                            <span> changed <b>@Display.PropertyName(entry.PropertyName)</b> <code>@entry.OldValue</code> → <code>@entry.NewValue</code></span>
                            break;
                        case Domain.Auditing.AuditKind.Created:
                            <span> created this line</span>
                            break;
                        case Domain.Auditing.AuditKind.Deleted:
                            <span> removed this line</span>
                            break;
                        default:
                            <span> @entry.Description</span>
                            break;
                    }
                </div>
                <span class="when" title="@entry.TimestampUtc.ToString("u")">@Display.Relative(entry.TimestampUtc)</span>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<AuditEntryDto>? entries;
    private Guid loadedFor;
    private int loadedVersion = -1;

    [Parameter, EditorRequired]
    public BudgetLineDto Line { get; set; } = default!;

    /// <summary>Bump to force a reload after an edit to the same line.</summary>
    [Parameter]
    public int Version { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Line.Id && loadedVersion == Version)
        {
            return;
        }

        loadedFor = Line.Id;
        loadedVersion = Version;
        entries = null;
        entries = await AuditQuery.GetHistoryAsync(nameof(BudgetLine), Line.Id);
    }

}
