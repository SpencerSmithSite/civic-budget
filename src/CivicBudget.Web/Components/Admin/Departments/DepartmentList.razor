@page "/admin/departments"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@inject IDepartmentService DepartmentService
@inject IJSRuntime JS

<PageTitle>Departments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Departments</h1>
    <a class="btn btn-primary" href="admin/departments/new">New department</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" placeholder="Search code or name" @bind="search" @bind:event="oninput" aria-label="Search departments" />
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="includeInactive" @bind="includeInactive" @bind:after="LoadAsync" />
            <label class="form-check-label" for="includeInactive">Show inactive</label>
        </div>
    </div>
</div>

@if (departments is null)
{
    <p>Loading...</p>
}
else
{
    <QuickGrid Items="Filtered" Class="table table-striped table-hover" Pagination="pagination">
        <PropertyColumn Property="d => d.Code" Sortable="true" />
        <PropertyColumn Property="d => d.Name" Sortable="true" />
        <PropertyColumn Property="d => d.Description" Title="Description" />
        <TemplateColumn Title="Status">
            @if (context.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }
        </TemplateColumn>
        <TemplateColumn Title="" Align="Align.End">
            <a class="btn btn-sm btn-outline-primary" href="admin/departments/@context.Id">Edit</a>
            @if (context.IsActive)
            {
                <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => SetActiveAsync(context, false)">Deactivate</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => SetActiveAsync(context, true)">Reactivate</button>
            }
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
}

@code {
    private IReadOnlyList<DepartmentDto>? departments;
    private string search = "";
    private bool includeInactive;
    private readonly PaginationState pagination = new() { ItemsPerPage = 20 };

    private IQueryable<DepartmentDto> Filtered => (departments ?? [])
        .Where(d => string.IsNullOrWhiteSpace(search)
            || d.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
            || d.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
        .AsQueryable();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => departments = await DepartmentService.ListAsync(includeInactive);

    private async Task SetActiveAsync(DepartmentDto department, bool isActive)
    {
        string verb = isActive ? "Reactivate" : "Deactivate";
        if (!await JS.InvokeAsync<bool>("confirm", $"{verb} department {department.Code} {department.Name}?"))
        {
            return;
        }

        await DepartmentService.SetActiveAsync(department.Id, isActive);
        await LoadAsync();
    }
}
