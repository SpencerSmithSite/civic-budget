@page "/admin/departments"
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@inject IDepartmentService DepartmentService
@inject ToastService Toasts
@inject CivicBudget.Application.Erp.IChartSyncService ChartSync
@using CivicBudget.Web.Components.Admin.Chart

<PageTitle>Departments</PageTitle>

<PageHeader Title="Departments" Eyebrow="Setup" Crumbs="@([new Crumb("Setup"), new Crumb("Departments")])">
    <Actions><a class="btn btn-outline-primary btn-sm" href="admin/export/setup/departments.xlsx"><i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Export XLSX</a>@if (!erpManaged) { <a class="btn btn-primary btn-sm" href="admin/departments/new"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New department</a> }</Actions>
</PageHeader>

<ChartSourceBanner Status="chartStatus" />

<div class="card">
    <div class="cb-toolbar">
        <input class="form-control" placeholder="Search code or name" @bind="search" @bind:event="oninput" aria-label="Search departments" />
        <div class="form-check ms-2">
            <input class="form-check-input" type="checkbox" id="includeInactive" @bind="includeInactive" @bind:after="LoadAsync" />
            <label class="form-check-label small" for="includeInactive">Show inactive</label>
        </div>
    </div>
    @if (departments is null)
    {
        <SkeletonRows Rows="5" Columns="4" />
    }
    else if (!Filtered.Any())
    {
        <EmptyState Icon="bi-diagram-3" Title="@(departments.Count == 0 ? "No departments yet" : "No departments match")" Text="@(departments.Count == 0 ? "Add the departments that will enter budget lines." : "Try a different search.")">
            @if (departments.Count == 0) { <a class="btn btn-primary btn-sm" href="admin/departments/new">New department</a> }
        </EmptyState>
    }
    else
    {
        <div class="cb-grid-wrap">
            <QuickGrid Items="Filtered" Theme="bootstrap" Class="cb-grid" Pagination="pagination">
                <PropertyColumn Property="d => d.Code" Sortable="true" />
                <PropertyColumn Property="d => d.Name" Sortable="true" Class="cb-wrap" />
                <TemplateColumn Title="Description" Class="cb-wrap"><span class="small text-secondary">@context.Description</span></TemplateColumn>
                <TemplateColumn Title="Status">
                    @if (context.IsActive) { <StatusPill Tone="success" Label="Active" /> } else { <StatusPill Label="Inactive" /> }
                </TemplateColumn>
                <TemplateColumn Title="" Align="Align.End">
                    @if (!erpManaged) {
                    <RowMenu Label="@($"Actions for {context.Code}")">
                        <li><a class="dropdown-item" href="admin/departments/@context.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit</a></li>
                        <li><hr class="dropdown-divider"></li>
                        @if (context.IsActive)
                        {
                            <li><button type="button" class="dropdown-item" @onclick="() => Ask(context, false)"><i class="bi bi-archive me-2" aria-hidden="true"></i>Deactivate</button></li>
                        }
                        else
                        {
                            <li><button type="button" class="dropdown-item" @onclick="() => Ask(context, true)"><i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>Reactivate</button></li>
                        }
                    </RowMenu>
                    }
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="cb-grid-foot"><span>@Filtered.Count() departments</span><Paginator State="pagination" /></div>
    }
</div>

<ConfirmDialog @ref="dialog" Title="@($"{(pendingActive ? "Reactivate" : "Deactivate")} {pending?.Code} {pending?.Name}?")" ConfirmText="@(pendingActive ? "Reactivate" : "Deactivate")" ConfirmClass="@(pendingActive ? "btn-primary" : "btn-danger")" OnConfirm="ConfirmAsync">
    <Body><p>@(pendingActive ? "The department will accept new budget lines again." : "Existing budget lines keep their history; new lines cannot use this department.")</p></Body>
</ConfirmDialog>

@code {
    private CivicBudget.Application.Erp.ChartSourceStatusDto? chartStatus;
    private bool erpManaged => chartStatus?.Source == CivicBudget.Domain.Erp.ChartSource.Erp;

    private IReadOnlyList<DepartmentDto>? departments;
    private string search = "";
    private bool includeInactive;
    private readonly PaginationState pagination = new() { ItemsPerPage = 20 };
    private ConfirmDialog dialog = default!;
    private DepartmentDto? pending;
    private bool pendingActive;

    private IQueryable<DepartmentDto> Filtered => (departments ?? [])
        .Where(d => string.IsNullOrWhiteSpace(search)
            || d.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
            || d.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
        .AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        chartStatus = await ChartSync.StatusAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => departments = await DepartmentService.ListAsync(includeInactive);

    private void Ask(DepartmentDto department, bool isActive)
    {
        pending = department;
        pendingActive = isActive;
        dialog.Show();
    }

    private async Task<bool> ConfirmAsync()
    {
        if (pending is null)
        {
            return true;
        }

        Result result = await DepartmentService.SetActiveAsync(pending.Id, pendingActive);
        if (result.IsSuccess)
        {
            Toasts.Success($"{pending.Code} {pending.Name} {(pendingActive ? "reactivated" : "deactivated")}.");
        }
        else
        {
            Toasts.Danger(result.Errors[0].Message);
        }

        await LoadAsync();
        return true;
    }
}
