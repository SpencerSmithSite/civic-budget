@page "/admin/fiscal-years"
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@inject IFiscalYearService FiscalYearService
@inject ToastService Toasts

<PageTitle>Fiscal years</PageTitle>

<PageHeader Title="Fiscal years" Eyebrow="Setup" Crumbs="@([new Crumb("Setup"), new Crumb("Fiscal years")])" Tip="Dates follow the government's fiscal year start month. A closed year accepts no new budget versions.">
</PageHeader>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            @if (fiscalYears is null)
            {
                <SkeletonRows Rows="4" Columns="5" />
            }
            else
            {
                <div class="cb-grid-wrap">
                    <table class="cb-grid">
                        <thead><tr><th>Year</th><th>Starts</th><th>Ends</th><th class="cb-num">Budget versions</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (FiscalYearDto fy in fiscalYears)
                            {
                                <tr>
                                    <td class="fw-semibold">@fy.Label</td>
                                    <td>@fy.StartDate.ToString("MMM d, yyyy")</td>
                                    <td>@fy.EndDate.ToString("MMM d, yyyy")</td>
                                    <td class="cb-num">@fy.VersionCount</td>
                                    <td>@if (fy.IsClosed) { <StatusPill Label="Closed" /> } else { <StatusPill Tone="success" Label="Open" /> }</td>
                                    <td class="text-end">
                                        <RowMenu Label="@($"Actions for {fy.Label}")">
                                            @if (fy.IsClosed)
                                            {
                                                <li><button type="button" class="dropdown-item" @onclick="() => Ask(fy, false)"><i class="bi bi-unlock me-2" aria-hidden="true"></i>Reopen</button></li>
                                            }
                                            else
                                            {
                                                <li><button type="button" class="dropdown-item" @onclick="() => Ask(fy, true)"><i class="bi bi-lock me-2" aria-hidden="true"></i>Close</button></li>
                                            }
                                        </RowMenu>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Add a fiscal year</div>
            <div class="card-body">
                <ResultAlert Result="result" />
                <EditForm EditContext="editContext" OnSubmit="CreateAsync">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="year">Year</label>
                        <InputNumber id="year" class="form-control" @bind-Value="model.Year" />
                        <ValidationMessage For="() => model.Year" class="text-danger" />
                        <div class="form-text">The label year is the calendar year in which the fiscal year ends.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">Add year</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<ConfirmDialog @ref="dialog" Title="@($"{(pendingClosed ? "Close" : "Reopen")} {pending?.Label}?")" ConfirmText="@(pendingClosed ? "Close year" : "Reopen year")" ConfirmClass="@(pendingClosed ? "btn-danger" : "btn-primary")" OnConfirm="ConfirmAsync">
    <Body><p>@(pendingClosed ? "No new budget versions can be created for this year. Existing versions are unaffected." : "New budget versions can be created for this year again.")</p></Body>
</ConfirmDialog>

@code {
    private IReadOnlyList<FiscalYearDto>? fiscalYears;
    private readonly FormModel model = new() { Year = DateTime.Today.Year + 1 };
    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private Result? result;
    private ConfirmDialog dialog = default!;
    private FiscalYearDto? pending;
    private bool pendingClosed;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        messages = new ValidationMessageStore(editContext);
        await LoadAsync();
    }

    private async Task LoadAsync() => fiscalYears = await FiscalYearService.ListAsync();

    private async Task CreateAsync()
    {
        Result<Guid> created = await FiscalYearService.CreateAsync(new CreateFiscalYearRequest(model.Year));
        result = created.IsSuccess ? null : created;
        editContext.ApplyErrors(messages, created);
        if (created.IsSuccess)
        {
            Toasts.Success($"FY{model.Year} added.");
            model.Year++;
            await LoadAsync();
        }
    }

    private void Ask(FiscalYearDto fiscalYear, bool isClosed)
    {
        pending = fiscalYear;
        pendingClosed = isClosed;
        dialog.Show();
    }

    private async Task<bool> ConfirmAsync()
    {
        if (pending is null)
        {
            return true;
        }

        Result changed = await FiscalYearService.SetClosedAsync(pending.Id, pendingClosed);
        if (changed.IsSuccess)
        {
            Toasts.Success($"{pending.Label} {(pendingClosed ? "closed" : "reopened")}.");
        }
        else
        {
            Toasts.Danger(changed.Errors[0].Message);
        }

        await LoadAsync();
        return true;
    }

    private sealed class FormModel
    {
        public int Year { get; set; }
    }
}
