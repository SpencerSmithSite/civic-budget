@page "/admin"
@using CivicBudget.Application.Publishing
@inject IGovernmentSettingsService SettingsService
@inject IBudgetEntryService BudgetEntry
@inject IPublishingService Publishing
@inject IAuditQueryService AuditQuery
@inject IFundService Funds
@inject NavigationManager Navigation

<PageTitle>Overview</PageTitle>

<PageHeader Title="Overview" Eyebrow="@(government?.Name ?? "")" Crumbs="@([new Crumb("Budget"), new Crumb("Overview")])">
    <Actions>
        <a class="btn btn-outline-primary btn-sm" href="admin/budgets">Budget versions</a>
        @if (openVersion is not null)
        {
            <a class="btn btn-primary btn-sm" href="admin/budgets/@openVersion.Id">Continue FY@(openVersion.Year) @openVersion.Label.ToLowerInvariant()</a>
        }
    </Actions>
</PageHeader>

@if (government is null || versions is null)
{
    <SkeletonRows Rows="6" Columns="4" />
}
else
{
    <div class="cb-kpis">
        @if (openWorkspace is not null)
        {
            <KpiCard Label="@($"FY{openWorkspace.Version.Year} appropriations")" Value="@Display.Money(openWorkspace.FundBalances.Sum(f => f.Summary.Appropriations))" Detail="@($"{openWorkspace.Lines.Count} lines, {openWorkspace.Version.Label.ToLowerInvariant()}, {openWorkspace.Version.Status.ToString().ToLowerInvariant()}")" />
            <KpiCard Label="Estimated resources" Value="@Display.Money(openWorkspace.FundBalances.Sum(f => f.Summary.EstimatedResources))" Tip="Beginning balances plus revenues plus transfers in, across every fund. Ohio law caps appropriations at this figure." />
            <KpiCard Label="Funds over limit" Value="@($"{overLimit} of {openWorkspace.FundBalances.Count}")" Tone="@(overLimit > 0 ? (openWorkspace.AnyFundBlocksWorkflow ? "bad" : "warn") : "ok")"
                     Detail="@(overLimit > 0 ? string.Join(", ", openWorkspace.FundBalances.Where(f => !f.Summary.IsWithinAppropriationLimit).Select(f => $"{f.FundCode} over by {Display.Money(f.Limit.AmountOverLimit)}")) : "Every fund within estimated resources")"
                     DetailTone="@(overLimit > 0 ? "down" : "")" />
        }
        else
        {
            <KpiCard Label="Budget in progress" Value="None" Tip="Start an amendment from an adopted budget, or add a fiscal year to begin a new one." />
        }
        <KpiCard Label="Public portal" Value="@(latestSnapshot is null ? "Nothing published" : $"FY{latestSnapshot.FiscalYear}")" Tone="@(latestSnapshot is null ? "warn" : "ok")"
                 Detail="@(latestSnapshot is null ? null : $"{latestSnapshot.VersionLabel}, published {latestSnapshot.PublishedAtUtc:MMM d, yyyy}")"
                 Tip="@(latestSnapshot is null ? "Publish an adopted version to open the public portal." : null)" />
    </div>

    @* Versions and government on the left, activity on the right, side by side from 1400px; the
       versions card stretches so the two columns end together. Narrower screens stack the cards. *@
    <div class="row g-3">
        <div class="col-xxl-7 d-flex flex-column gap-3">
            <div class="card flex-grow-1">
                <div class="card-header d-flex align-items-center">Budget versions <a class="ms-auto small fw-normal" href="admin/budgets">All versions ›</a></div>
                <div class="cb-cards d-md-none">
                    @foreach (BudgetVersionSummaryDto version in versions.Take(6))
                    {
                        <ListCard Title="@($"FY{version.Year} {version.Label}")" Href="@($"admin/budgets/{version.Id}")">
                            <Summary>@version.LineCount lines@(version.ResolutionNumber is null ? "" : $" · resolution {version.ResolutionNumber}")</Summary>
                            <Aside><StatusPill Budget="version.Status" />@PortalPill(version)</Aside>
                        </ListCard>
                    }
                </div>
                <div class="cb-grid-wrap cb-grid-wrap-fill d-none d-md-block">
                    <table class="cb-grid cb-grid-tight">
                        <thead><tr><th>Fiscal year</th><th>Version</th><th>Status</th><th>Resolution</th><th>Portal</th><th class="cb-num">Lines</th><th></th></tr></thead>
                        <tbody>
                            @foreach (BudgetVersionSummaryDto version in versions.Take(6))
                            {
                                <tr>
                                    <td>FY@(version.Year)</td>
                                    <td>@version.Label</td>
                                    <td><StatusPill Budget="version.Status" /></td>
                                    <td class="cb-code">@version.ResolutionNumber</td>
                                    <td>@PortalPill(version)</td>
                                    <td class="cb-num">@version.LineCount</td>
                                    <td class="text-end"><a href="admin/budgets/@version.Id">@(version.Status == BudgetStatus.Adopted ? "Open" : "Continue")</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="card-header">Government</div>
                <dl class="row mb-0 p-3 small">
                    <dt class="col-5 fw-semibold">Type</dt><dd class="col-7">@Display.Enum(government.Type), @government.State</dd>
                    <dt class="col-5 fw-semibold">Fiscal year starts</dt><dd class="col-7">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(government.FiscalYearStartMonth)</dd>
                    <dt class="col-5 fw-semibold">Appropriation limit</dt><dd class="col-7">@(government.AppropriationLimitMode == AppropriationLimitMode.Block ? "Block over-appropriated funds" : "Warn on over-appropriated funds")</dd>
                    <dt class="col-5 fw-semibold">Public address</dt><dd class="col-7 mb-0"><code>/transparency/@government.PublicSlug</code></dd>
                </dl>
            </div>
        </div>
        <div class="col-xxl-5">
            <div class="card">
                <div class="card-header">Recent activity</div>
                @if (activity is null || activity.Count == 0)
                {
                    <EmptyState Icon="bi-clock-history" Title="No activity yet" Text="Changes to budget lines and workflow actions appear here." />
                }
                else
                {
                    <ul class="cb-timeline">
                        @foreach (AuditEntryDto entry in activity)
                        {
                            <li>
                                <Avatar UserId="@entry.UserId" Name="@entry.UserName" />
                                <div><b>@entry.UserName</b> @Describe(entry)</div>
                                <span class="when" title="@entry.TimestampUtc.ToString("u")">@Display.Relative(entry.TimestampUtc)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@code {
    // One helper for the grid and the phone card, so the two always agree, and with the versions list,
    // on what a version's publishing state is called.
    private RenderFragment? PortalPill(BudgetVersionSummaryDto version) =>
        snapshots?.Any(s => s.BudgetVersionId == version.Id && s.Status == Domain.Publishing.SnapshotStatus.Active) == true
            ? @<StatusPill Tone="success" Label="Published" />
            : snapshots?.Any(s => s.BudgetVersionId == version.Id) == true ? @<span class="cb-code">Previously published</span> : null;

    private GovernmentSettingsDto? government;
    private IReadOnlyList<BudgetVersionSummaryDto>? versions;
    private IReadOnlyList<SnapshotSummaryDto>? snapshots;
    private BudgetVersionSummaryDto? openVersion;
    private BudgetWorkspaceDto? openWorkspace;
    private SnapshotSummaryDto? latestSnapshot;
    private IReadOnlyList<AuditEntryDto>? activity;
    private int overLimit;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // A department user's home is their department, not the government-wide overview.
        if ((await AuthenticationState).User.IsInRole(Roles.DepartmentHead))
        {
            Navigation.NavigateTo("admin/my-department", replace: true);
            return;
        }

        government = await SettingsService.GetAsync();
        versions = await BudgetEntry.ListVersionsAsync();
        snapshots = await Publishing.ListAsync();
        latestSnapshot = snapshots.Where(s => s.Status == Domain.Publishing.SnapshotStatus.Active).OrderByDescending(s => s.FiscalYear).FirstOrDefault();

        openVersion = versions.FirstOrDefault(v => v.Status != BudgetStatus.Adopted);
        if (openVersion is not null)
        {
            openWorkspace = await BudgetEntry.GetWorkspaceAsync(openVersion.Id);
            overLimit = openWorkspace?.FundBalances.Count(f => !f.Summary.IsWithinAppropriationLimit) ?? 0;
        }

        activity = await AuditQuery.GetRecentAsync(6);
    }

    private static string Describe(AuditEntryDto entry) => entry.Kind switch
    {
        Domain.Auditing.AuditKind.FieldChanged => $"changed {Display.PropertyName(entry.PropertyName)} on a {Display.EntityName(entry.EntityName)}: {entry.OldValue} → {entry.NewValue}",
        Domain.Auditing.AuditKind.Created => $"created a {Display.EntityName(entry.EntityName)}",
        Domain.Auditing.AuditKind.Deleted => $"removed a {Display.EntityName(entry.EntityName)}",
        _ => entry.Description ?? "",
    };

}
