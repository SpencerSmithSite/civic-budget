@page "/admin/funds"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.CanMaintainSetup)]
@inject IFundService FundService
@inject IJSRuntime JS

<PageTitle>Funds</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Funds</h1>
    <a class="btn btn-primary" href="admin/funds/new">New fund</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" placeholder="Search code or name" @bind="search" @bind:event="oninput" aria-label="Search funds" />
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="includeInactive" @bind="includeInactive" @bind:after="LoadAsync" />
            <label class="form-check-label" for="includeInactive">Show inactive</label>
        </div>
    </div>
</div>

@if (funds is null)
{
    <p>Loading...</p>
}
else
{
    <QuickGrid Items="Filtered" Class="table table-striped table-hover" Pagination="pagination">
        <PropertyColumn Property="f => f.Code" Sortable="true" />
        <PropertyColumn Property="f => f.Name" Sortable="true" />
        <TemplateColumn Title="Category" SortBy="GridSort<FundDto>.ByAscending(f => f.Category)">
            @Display.Enum(context.Category) <span class="text-secondary small">(@context.Group)</span>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            @if (context.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }
        </TemplateColumn>
        <TemplateColumn Title="" Align="Align.End">
            <a class="btn btn-sm btn-outline-primary" href="admin/funds/@context.Id">Edit</a>
            @if (context.IsActive)
            {
                <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => SetActiveAsync(context, false)">Deactivate</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => SetActiveAsync(context, true)">Reactivate</button>
            }
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
}

@code {
    private IReadOnlyList<FundDto>? funds;
    private string search = "";
    private bool includeInactive;
    private readonly PaginationState pagination = new() { ItemsPerPage = 20 };

    // QuickGrid wants an IQueryable; filtering in memory is fine for a chart of accounts (tens of rows, not thousands).
    private IQueryable<FundDto> Filtered => (funds ?? [])
        .Where(f => string.IsNullOrWhiteSpace(search)
            || f.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
            || f.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
        .AsQueryable();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => funds = await FundService.ListAsync(includeInactive);

    private async Task SetActiveAsync(FundDto fund, bool isActive)
    {
        string verb = isActive ? "Reactivate" : "Deactivate";
        if (!await JS.InvokeAsync<bool>("confirm", $"{verb} fund {fund.Code} {fund.Name}?"))
        {
            return;
        }

        await FundService.SetActiveAsync(fund.Id, isActive);
        await LoadAsync();
    }
}
