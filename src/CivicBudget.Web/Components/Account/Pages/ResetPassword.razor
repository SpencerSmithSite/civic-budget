@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using CivicBudget.Application.Users
@inject IAccountEmailService AccountEmail

@* Where an emailed reset or welcome link lands: choose a password, then sign in with it. *@
<PageTitle>Choose a password</PageTitle>

<div class="cb-login">
    <div class="cb-login-left">
        <h1>Budgeting and public transparency for local governments.</h1>
        <SignInArt />
    </div>
    <div class="cb-login-right">
        <div class="card cb-login-card">
            <div class="card-body p-4">
                @if (done)
                {
                    <h2 class="h5 mb-2">Your password is set</h2>
                    <p class="mb-3">Sign in with it now.</p>
                    <a class="btn btn-primary w-100" href="Account/Login">Sign in</a>
                }
                else if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code))
                {
                    <h2 class="h5 mb-2">This link is incomplete</h2>
                    <p class="mb-3">Open the link from your email again, or ask for a new one.</p>
                    <a href="Account/ForgotPassword">Email me a new link</a>
                }
                else
                {
                    <h2 class="h5 mb-1">Choose a password</h2>
                    <p class="text-secondary small mb-3">At least 10 characters. Only you will know it.</p>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger small" role="alert">@error @if (expired) { <a href="Account/ForgotPassword">Email me a new link</a> }</div>
                    }
                    <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="Input.Password" class="form-label fw-semibold">New password</label>
                            <PasswordInput @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                            <ValidationMessage For="() => Input.Password" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm it</label>
                            <PasswordInput @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                        </div>
                        <button type="submit" class="w-100 btn btn-primary">Set password</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool done;
    private bool expired;
    private string? error;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    // Form posts can set this to null before OnInitialized runs, so it is initialized there, not here (BL0008).
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ResetAsync()
    {
        Result result = await AccountEmail.ResetPasswordAsync(UserId!, Code!, Input.Password);
        if (result.IsSuccess)
        {
            done = true;
            return;
        }

        error = string.Join(" ", result.Errors.Select(e => e.Message));
        expired = result.Errors.Any(e => string.IsNullOrEmpty(e.PropertyName));
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(100, ErrorMessage = "The password must be at least {2} and at most {1} characters long.", MinimumLength = 10)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
