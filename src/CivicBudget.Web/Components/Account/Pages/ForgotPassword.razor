@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using CivicBudget.Application.Notifications
@using CivicBudget.Application.Users
@inject IAccountEmailService AccountEmail
@inject IEmailOutbox Outbox

@* Asks for an address and emails a reset link if it has an account. The page answers the same way
   whether it does or not, so it cannot be used to learn who has an account. *@
<PageTitle>Forgot your password? | CivicBudget</PageTitle>

<div class="cb-login">
    <div class="cb-login-left">
        <p class="cb-login-tagline">Budgeting and public transparency for local governments.</p>
        <SignInArt />
    </div>
    <div class="cb-login-right">
        <div class="card cb-login-card">
            <div class="card-body p-4">
                @if (sent)
                {
                    <h1 class="h5 mb-2">Check your email</h1>
                    <p class="mb-3">If <b>@Input.Email</b> has a CivicBudget account, a link to choose a new password is on its way. It works once, for a day.</p>
                    @if (!Outbox.Delivers)
                    {
                        <div class="alert alert-info small" role="status">
                            <i class="bi bi-info-circle me-2" aria-hidden="true"></i>This demo does not send email, because its addresses are fictional. The message is in the <b>Email outbox</b>, which an administrator can open from the menu.
                        </div>
                    }
                    <a href="Account/Login">Back to sign in</a>
                }
                else
                {
                    <h1 class="h5 mb-1">Forgot your password?</h1>
                    <p class="text-secondary small mb-3">Enter your email and we will send you a link to choose a new one.</p>
                    <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password">
                        <DataAnnotationsValidator />
                        <FormErrors />
                        <div class="mb-3">
                            <label for="Input.Email" class="form-label fw-semibold">Email</label>
                            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>
                        <button type="submit" class="w-100 btn btn-primary">Email me a link</button>
                    </EditForm>
                    <div class="mt-3 small"><a href="Account/Login">Back to sign in</a></div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool sent;

    [SupplyParameterFromForm]
    // Form posts can set this to null before OnInitialized runs, so it is initialized there, not here (BL0008).
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        await AccountEmail.RequestPasswordResetAsync(Input.Email);
        sent = true;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
