@page "/transparency/{Slug}/{Year:int}/ask"
@using CivicBudget.Application.Assistant
@attribute [Microsoft.AspNetCore.Antiforgery.RequireAntiforgeryToken(required: false)]
@inject ISnapshotQueryService Snapshots
@inject IPortalQuestionService Questions

@* Civic Buddy's page, where every question is answered (ADR-0049, ADR-0051). A plain form post, so
   it works with JavaScript off like the rest of the portal; the floating panel and the suggested
   questions post here too, naming this form in _handler. No antiforgery token: the portal sets no
   cookies and a question carries no identity to protect; the per-address limit (RateLimits) and the
   monthly cap bound what a forged post could cost. The empty page is cached like any portal page;
   an answer, being a POST, never is. *@
<PageTitle>@(budget is null ? "Ask Civic Buddy" : $"Ask Civic Buddy about the FY{budget.FiscalYear} budget, {budget.GovernmentName}")</PageTitle>

@if (loaded && (budget is null || !available))
{
    <PortalNotFound />
}
else if (budget is not null)
{
    <PortalHero Title="Ask Civic Buddy" Eyebrow="@($"AI answers · {budget.FiscalYear} budget")" Crumbs="@([new Crumb($"{budget.FiscalYear} budget", Root), new Crumb("Civic Buddy")])">
        <Lead>Ask about the budget in your own words, the way you would ask at the @(budget.GovernmentName.Split(',')[0]) office. Civic Buddy answers only from the budget published here, with a link to the page that shows it.</Lead>
    </PortalHero>

    <div class="pt-buddy-page pt-card">
        <div id="answer">
            @if (answer is not null)
            {
                <PortalAnswerView Question="@asked" Answer="answer" LinkPrefix="@($"/transparency/{Slug}/")" />
            }
            else if (refusal is not null)
            {
                <div class="alert alert-warning pt-ask-refusal" role="alert">@refusal</div>
            }
        </div>

        <form method="post" action="@($"{Root}/ask#answer")" @formname="@FormName" @onsubmit="AskAsync" class="pt-ask pt-buddy-form">
            <BuddyComposer IdPrefix="ask" Year="budget.FiscalYear" Label="@(answer is null ? "Your question" : "Ask another question")" />
        </form>

        @if (answer is null)
        {
            <BuddySuggestions IdPrefix="ask" Action="@($"{Root}/ask#answer")" />
        }

        <BuddyNote />
    </div>
}

@code {
    /// <summary>The form every question posts as; the floating panel and the suggested questions send it as _handler.</summary>
    public const string FormName = "portal-ask";

    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int Year { get; set; }

    [SupplyParameterFromForm(FormName = FormName)]
    public string? Question { get; set; }

    private string Root => $"/transparency/{Slug}/{Year}";

    private PortalBudgetDto? budget;
    private bool available;
    private bool loaded;
    private string asked = "";
    private PortalAnswer? answer;
    private string? refusal;

    protected override async Task OnInitializedAsync()
    {
        // No model, no database: the page is not found, as it would be for an unpublished budget.
        if (Questions.ModelConfigured)
        {
            budget = await Snapshots.GetBudgetAsync(Slug, Year);
            available = budget is not null && await Questions.IsAvailableAsync(Slug);
        }

        loaded = true;
    }

    private async Task AskAsync()
    {
        if (!available)
        {
            return;
        }

        asked = (Question ?? "").Trim();
        Result<PortalAnswer> result = await Questions.AskAsync(Slug, Year, asked);
        answer = result.IsSuccess ? result.Value : null;
        refusal = result.IsSuccess ? null : result.Errors[0].Message;
    }
}
