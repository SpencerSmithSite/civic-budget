@page "/transparency"
@inject ISnapshotQueryService Snapshots

<PageTitle>Budget transparency</PageTitle>

<h1 class="pt-h1">Budget transparency</h1>
<p class="pt-lead">Pick a government to see where its money comes from and where it goes.</p>

@if (governments is null)
{
    <p class="pt-muted">Loading…</p>
}
else if (governments.Count == 0)
{
    @* The index exists even when it is empty, so this is a page, not a 404. *@
    <div class="pt-empty">
        <p>No government has published a budget yet. Budgets appear here as soon as they are adopted and published.</p>
    </div>
}
else
{
    <ul class="pt-govlist">
        @foreach ((string slug, string name) in governments)
        {
            <li><a href="/transparency/@slug">@name</a></li>
        }
    </ul>
}

@code {
    private IReadOnlyList<(string Slug, string Name)>? governments;

    protected override async Task OnInitializedAsync() => governments = await Snapshots.ListGovernmentsAsync();
}
