@page "/transparency/{Slug}"
@page "/transparency/{Slug}/{Year:int}"
@inject ISnapshotQueryService Snapshots

<PageTitle>@(budget is null ? "Budget" : $"{budget.GovernmentName} FY{budget.FiscalYear} budget")</PageTitle>

@if (loaded && budget is null)
{
    <PortalNotFound />
}
else if (budget is not null && byFund is not null && revenue is not null)
{
    <PortalHero Title="@($"The {budget.FiscalYear} budget")" Overlap="true">
        <Lead>@(budget.GovernmentDescription ?? $"What {budget.GovernmentName} expects to take in, plans to spend, and keeps in reserve in {budget.FiscalYear}, as council adopted it.")</Lead>
        <Actions>
            @if (budget.HasBook)
            {
                <a class="pt-hero-btn" href="@Root/budget-book.pdf"><PortalIcon Name="book" Size="18" />Read the budget book (PDF)</a>
            }
            <a class="pt-hero-btn pt-hero-btn--ghost" href="@Root/download.xlsx"><PortalIcon Name="download" Size="18" />Download the numbers</a>
        </Actions>
        <Aside>
            @if (budget.AvailableYears.Count > 1)
            {
                <nav class="pt-years" aria-label="Fiscal year">
                    @foreach (PortalYearDto y in budget.AvailableYears)
                    {
                        <a href="/transparency/@Slug/@y.FiscalYear" class="@(y.FiscalYear == budget.FiscalYear ? "on" : "")" aria-current="@(y.FiscalYear == budget.FiscalYear ? "page" : null)">FY@(y.FiscalYear)</a>
                    }
                </nav>
            }
        </Aside>
    </PortalHero>

    <div class="pt-kpis pt-kpis--lift">
        <PortalKpi Icon="in" Label="Revenues" Amount="budget.TotalRevenues" Text="Taxes, state funding, utility bills, fees, and interest the government expects to receive." Href="@($"{Root}/revenue")" LinkText="Where it comes from" />
        <PortalKpi Icon="out" Label="Expenditures" Amount="budget.TotalExpenditures" Text="What council authorized departments to spend, including debt payments." Href="@($"{Root}/spending")" LinkText="Where it goes" />
        <PortalKpi Icon="balance" Label="Projected ending balance" Amount="budget.ProjectedEndingBalance" Text="@($"Money carried into {budget.FiscalYear + 1} across all funds, after this year's revenues and spending.")" Href="@($"{Root}/funds")" LinkText="Fund balances" />
    </div>

    <PortalPanels Name="money" Label="Spending or revenue" FirstTitle="Where does the money go?" SecondTitle="Where does it come from?" SecondFirst="@(View == "revenue")">
        <First>
            <Breakdown Title="Where does the money go?" HideTitle="true" Data="byFund" ItemHeader="Fund" Open="true"
                       ShowPercent="ShowPercent" PageHref="@Root" LinkFor="@(item => $"{Root}/funds/{item.Key}")" />
        </First>
        <Second>
            <Breakdown Title="Where does it come from?" HideTitle="true" Data="revenue" ItemHeader="Source" Tone="rev" Open="true"
                       ShowPercent="ShowPercent" PageHref="@($"{Root}?view=revenue")" />
        </Second>
    </PortalPanels>

    <section class="pt-section" aria-labelledby="explore-title">
        <h2 id="explore-title" class="pt-q">Explore the budget</h2>
        <ul class="pt-explore">
            <li><a href="@Root/spending"><PortalIcon Name="spending" /><b>Where it goes</b><span>Spending by department, and what it buys.</span></a></li>
            <li><a href="@Root/revenue"><PortalIcon Name="revenue" /><b>Where it comes from</b><span>Taxes, state funding, fees, and more.</span></a></li>
            <li><a href="@Root/funds"><PortalIcon Name="funds" /><b>Funds</b><span>Each fund's money in, money out, and reserve.</span></a></li>
            <li><a href="@Root/outlook"><PortalIcon Name="outlook" /><b>Outlook</b><span>Where the budget is heading, year by year.</span></a></li>
            <li><a href="@Root/years"><PortalIcon Name="years" /><b>Year over year</b><span>How this budget compares with earlier ones.</span></a></li>
            @if (Askable)
            {
                <li><a href="@Root/ask"><PortalIcon Name="ask" /><b>Ask a question</b><span>In your own words, answered from this budget.</span></a></li>
            }
            else
            {
                <li><a href="@Root/search"><PortalIcon Name="search" /><b>Search</b><span>Find a fund, a department, or an account.</span></a></li>
            }
        </ul>
    </section>

    <div class="pt-trust">
        @if (budget.ResolutionNumber is not null) { <span><PortalIcon Name="resolution" Size="18" />Adopted by resolution <b>@budget.ResolutionNumber</b>@(budget.AdoptedOnUtc is { } a ? $" on {a:MMMM d, yyyy}" : "")</span> }
        <span><PortalIcon Name="published" Size="18" />Published <b>@Display.LongDate(budget.PublishedAtUtc)</b></span>
        <span><PortalIcon Name="version" Size="18" />Version <b>@budget.VersionLabel</b>@(budget.AmendmentReason is null ? "" : $": {budget.AmendmentReason}")</span>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int? Year { get; set; }
    [SupplyParameterFromQuery(Name = "show")] public string? Show { get; set; }

    /// <summary>"revenue" opens the second panel, so the $/% toggle and links can land on it.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    [CascadingParameter(Name = "PortalAskable")] public bool Askable { get; set; }

    private PortalBudgetDto? budget;
    private BreakdownDto? byFund;
    private BreakdownDto? revenue;
    private bool loaded;

    private bool ShowPercent => Show == "pct";
    private string Root => $"/transparency/{Slug}/{budget?.FiscalYear}";

    protected override async Task OnInitializedAsync()
    {
        budget = await Snapshots.GetBudgetAsync(Slug, Year);
        if (budget is not null)
        {
            byFund = await Snapshots.ExpendituresByFundAsync(Slug, budget.FiscalYear);
            revenue = await Snapshots.RevenuesByCategoryAsync(Slug, budget.FiscalYear);
        }

        loaded = true;
    }
}
