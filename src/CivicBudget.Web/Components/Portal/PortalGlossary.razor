@page "/transparency/{Slug}/{Year:int}/glossary"
@inject ISnapshotQueryService Snapshots

@* The words the portal uses, explained once, on their own page rather than under every page. The
   accessibility statement lives here too, so the footer can be a single line. *@
<PageTitle>@(budget is null ? "Glossary" : $"Glossary, {budget.GovernmentName}")</PageTitle>

@if (loaded && budget is null)
{
    <PortalNotFound />
}
else if (budget is not null)
{
    <PortalCrumbs Crumbs="@([new Crumb($"{Year} budget", Root), new Crumb("Glossary")])" />
    <h1 class="pt-h1">Glossary</h1>
    <p class="pt-lead">The budget uses a few words the way Ohio law does. Here is what they mean on this site.</p>

    <dl class="pt-glossary-list">
        @foreach (GlossaryTerm term in Glossary.Terms)
        {
            <dt>@term.Term</dt>
            <dd>@term.Definition</dd>
        }
    </dl>

    <section class="pt-section" id="accessibility" aria-labelledby="a11y">
        <h2 id="a11y" class="pt-q">Accessibility</h2>
        <p class="pt-lead-sm">This site is built to WCAG 2.1 AA: every chart has a table with the same numbers, nothing is conveyed by color alone, and every page works without JavaScript. If something does not work for you, contact the fiscal office.</p>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int Year { get; set; }

    private PortalBudgetDto? budget;
    private bool loaded;

    private string Root => $"/transparency/{Slug}/{Year}";

    protected override async Task OnInitializedAsync()
    {
        budget = await Snapshots.GetBudgetAsync(Slug, Year);
        loaded = true;
    }
}
