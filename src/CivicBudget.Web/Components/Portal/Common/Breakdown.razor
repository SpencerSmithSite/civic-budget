@* Sorted horizontal bars with direct value labels, a "$ | %" toggle, and the same numbers as a
   table below. The toggle is a pair of radio buttons styled as a switch, like PortalPanels: both
   values are in the page and CSS shows the one that matches the checked radio, so it switches in
   place with no JavaScript and no page load. Never color alone: every bar has its label
   and value beside it. Items can link to a drill-down page. *@
<section class="pt-section pt-card" aria-labelledby="@headingId">
    <div class="pt-section-head">
        <h2 id="@headingId" class="pt-q @(HideTitle ? "visually-hidden" : "")">@Title</h2>
        <fieldset class="pt-toggle">
            <legend class="visually-hidden">Show amounts as</legend>
            <input type="radio" name="@toggleName" id="@($"{toggleName}-amt")" class="pt-toggle-radio" checked="@(!ShowPercent)" />
            <label for="@($"{toggleName}-amt")"><span aria-hidden="true">$</span><span class="visually-hidden">Dollars</span></label>
            <input type="radio" name="@toggleName" id="@($"{toggleName}-pct")" class="pt-toggle-radio pt-toggle-pct" checked="@ShowPercent" />
            <label for="@($"{toggleName}-pct")"><span aria-hidden="true">%</span><span class="visually-hidden">Percent</span></label>
        </fieldset>
    </div>
    @if (Lead is not null)
    {
        <p class="pt-lead-sm">@Lead</p>
    }
    @if (Data.Items.Count == 0)
    {
        <p class="pt-muted">Nothing budgeted here.</p>
    }
    else
    {
        @* An image role hides its children from assistive technology, so it is only used when the bars
           have no links; linked bars stay a list people can tab through and hear. *@
        <div class="pt-bars @Tone" role="@(LinkFor is null ? "img" : "list")" aria-label="@(LinkFor is null ? AriaSummary : Title)">
            @foreach (BreakdownItemDto item in Data.Items)
            {
                decimal share = Data.ShareOf(item);
                decimal max = Data.Items.Max(i => i.Amount);
                decimal width = max <= 0 ? 0 : Math.Round(item.Amount / max * 100m, 1);
                <div class="pt-bar-row" role="@(LinkFor is null ? null : "listitem")">
                    <div class="pt-bar-label">
                        @if (LinkFor is not null && LinkFor(item) is { } href)
                        {
                            <a href="@href">@item.Label</a>
                        }
                        else
                        {
                            <span>@item.Label</span>
                        }
                    </div>
                    <div class="pt-bar-track"><div class="pt-bar-fill" style="width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                    <div class="pt-bar-value"><span class="pt-show-amt">@Display.Money(item.Amount)</span><span class="pt-show-pct">@($"{share.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}%")</span></div>
                </div>
            }
        </div>
        <details class="pt-table" open="@Open">
            <summary>Show as a table</summary>
            @* Focusable so a keyboard user can scroll a table wider than the screen. *@
            <div class="cb-grid-wrap" tabindex="0" role="region" aria-label="@($"Table: {Title}")">
                <table class="cb-grid pt-grid">
                    <caption class="visually-hidden">@Title</caption>
                    <thead>
                        <tr><th scope="col">@ItemHeader</th><th scope="col" class="cb-num">Amount</th><th scope="col" class="cb-num">Share</th><th scope="col" class="cb-num">Change vs prior year</th></tr>
                    </thead>
                    <tbody>
                        @foreach (BreakdownItemDto item in Data.Items)
                        {
                            <tr>
                                <th scope="row" class="fw-normal">@item.Label</th>
                                <td class="cb-num">@Display.Money(item.Amount)</td>
                                <td class="cb-num">@Data.ShareOf(item).ToString("0.0")%</td>
                                <td class="cb-num @(item.ChangePercent < 0 ? "cb-neg" : "")">@Display.Percent(item.ChangePercent)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th scope="row">Total</th><td class="cb-num">@Display.Money(Data.Total)</td><td class="cb-num">100%</td><td></td></tr>
                    </tfoot>
                </table>
            </div>
        </details>
    }
</section>

@code {
    /// <summary>Inside a tabbed panel the tab already shows the title; keep it for assistive technology only.</summary>
    [Parameter]
    public bool HideTitle { get; set; }

    // Derived from the title, so the ids stay the same from render to render (the page is cached).
    private string headingId => "bd-" + System.Text.RegularExpressions.Regex.Replace(Title.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    // One radio group per chart, so each chart's toggle is its own and none changes another's.
    private string toggleName => headingId + "-show";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Lead { get; set; }

    [Parameter, EditorRequired]
    public BreakdownDto Data { get; set; } = default!;

    /// <summary>Header for the first table column: "Fund", "Department", "Category".</summary>
    [Parameter]
    public string ItemHeader { get; set; } = "Item";

    /// <summary>"rev" colors the bars teal (money in); default navy (money out).</summary>
    [Parameter]
    public string Tone { get; set; } = "";

    [Parameter]
    public Func<BreakdownItemDto, string?>? LinkFor { get; set; }

    /// <summary>Whether the table twin starts expanded. The overview opens the first one so no-JS readers see numbers immediately.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Start on percentages: the page's ?show=pct, so a link to a page in percent mode still opens that way.</summary>
    [Parameter]
    public bool ShowPercent { get; set; }

    // A chart's text: every item when there are few, else the largest six and a count, so the label
    // never implies a short list is the whole one. The table beside it has every amount.
    private string AriaSummary => Data.Items.Count <= 6
        ? $"{Title}: " + string.Join("; ", Data.Items.Select(i => $"{i.Label} {Display.Money(i.Amount)}"))
        : $"{Title}, {Data.Items.Count} items, the largest six: " + string.Join("; ", Data.Items.Take(6).Select(i => $"{i.Label} {Display.Money(i.Amount)}")) + ". The table lists every amount.";
}
