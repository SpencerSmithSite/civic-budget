<div class="pt-kpi">
    @if (Icon is not null)
    {
        <PortalIcon Name="@Icon" />
    }
    <div class="cb-eyebrow">@Label</div>
    <div class="pt-kpi-v">@if (Amount is { } amount) { @MoneyShort.Speakable(amount) } else { @Value }</div>
    @if (Text is not null) { <p>@Text</p> }
    @if (Href is not null) { <a href="@Href">@LinkText <span aria-hidden="true">›</span></a> }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";

    /// <summary>An amount shown short ("$3.70M") and spoken in full; used instead of Value.</summary>
    [Parameter] public decimal? Amount { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string LinkText { get; set; } = "Explore";

    /// <summary>A <see cref="PortalIcon"/> name shown above the label.</summary>
    [Parameter] public string? Icon { get; set; }
}
