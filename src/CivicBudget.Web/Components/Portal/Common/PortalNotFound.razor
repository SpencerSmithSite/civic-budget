@* Marks a portal address as not found: a real 404, so crawlers and the output cache treat it
   correctly. It renders nothing itself. In .NET 10 a static page that sets 404 has its body
   discarded, and the status-code pages middleware re-executes /not-found (Pages/NotFound.razor),
   which shows the portal's wording and a link back to the portal index. The page-specific sentence
   travels there in HttpContext.Items, which survives the re-execution. *@

@code {
    public const string TextKey = "PortalNotFound.Text";

    [Parameter] public string Text { get; set; } = "Either the address is wrong or this government has not published a budget yet.";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is { Response.HasStarted: false })
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            HttpContext.Items[TextKey] = Text;
        }
    }
}
