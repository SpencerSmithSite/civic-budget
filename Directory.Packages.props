<Project>
  <!-- Central Package Management: every package version lives here, once.
       Each package must have a row in docs/DECISIONS.md "Packages". -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <EfCoreVersion>10.0.12</EfCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Data access -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <!-- Application -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Identity -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="$(EfCoreVersion)" />
    <!-- Web -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!-- Assistant: the model interface (Application), Claude behind it (Infrastructure), answers as safe HTML (Web) -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Anthropic" Version="12.51.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="Amazon.CDK.Lib" Version="2.272.0" />
    <PackageVersion Include="Constructs" Version="10.8.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
